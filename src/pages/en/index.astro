---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import Routes from "../../components/Routes.astro";
import Steps from "../../components/Steps.astro";
import Car from "../../components/Car.astro";
import Faq from "../../components/Faq.astro";
import Answers from "../../components/Answers.astro";
import SiteSchema from "../../components/SiteSchema.astro";
import CtaBand from "../../components/CtaBand.astro";
import HeroPreload from "../../components/HeroPreload.astro";

const lang = "en" as const;
---

<Base lang={lang} path="/">
  <HeroPreload slot="head" />
  <Hero lang={lang} />
  <Routes lang={lang} />
  <Car lang={lang} />
  <Steps lang={lang} />
  <Answers lang={lang} />
  <Faq lang={lang} />
  <CtaBand lang={lang} />
  <SiteSchema lang={lang} />
</Base>
