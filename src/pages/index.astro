---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Routes from "../components/Routes.astro";
import Steps from "../components/Steps.astro";
import Car from "../components/Car.astro";
import Faq from "../components/Faq.astro";
import Answers from "../components/Answers.astro";
import SiteSchema from "../components/SiteSchema.astro";

const lang = "ru" as const;
---

<Base lang={lang} path="/">
  <Hero lang={lang} />
  <Routes lang={lang} />
  <Car lang={lang} />
  <Steps lang={lang} />
  <Answers lang={lang} />
  <Faq lang={lang} />
  <SiteSchema lang={lang} />
</Base>
