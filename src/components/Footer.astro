---
import Messengers from "./Messengers.astro";
import ReviewButton from "./ReviewButton.astro";
import { useTranslations, facts, localePath, reviewsWord, type Lang, type UIKey } from "../i18n/ui";
import { footerLinks } from "../data/routes";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

// Ссылки берутся из данных о страницах, а не перечисляются руками: подвал
// стоит на каждой странице сайта, и это основная перелинковка. Новая
// посадочная страница появляется здесь сама.
const links = footerLinks(lang, (id) => t(`routes.${id}` as UIKey));
---

{/* data-nosnippet на обоих блоках подвала: он стоит на всех страницах, и
    Google цеплял из него текст в сниппет. Атрибут поддерживается только на
    div, span и section — вешать его на сам <footer> бесполезно.
    На индексацию и на ссылки внутри подвала это не влияет: запрет касается
    только показа текста в описании выдачи. */}
<footer class="border-t border-line bg-surface">
  <div
    class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:grid-cols-2 lg:grid-cols-6"
    data-nosnippet
  >
    <div class="lg:col-span-2">
      <p class="text-[1.05rem] font-semibold tracking-tight">
        Estonia<span class="text-brand-ink">Transfer</span>
      </p>
      <p class="mt-3 max-w-sm text-[0.95rem] leading-relaxed text-ink-muted">
        {t("footer.tagline")}
      </p>

      {/* Карточка отзывов Google — по образцу их официального бейджа.
          Статикой, без виджета Elfsight и подобных: у сайта CSP
          `default-src 'self'`, сторонний скрипт потребовал бы открыть
          script-src и connect-src наружу, поставил бы cookie (а из-за их
          отсутствия сайту не нужен баннер согласия) и рисовал бы отзывы
          скриптом — краулеры без JS не увидели бы ничего.

          Логотип и звёзды — inline SVG, не картинки: и лишних запросов нет,
          и с gstatic.com их бы всё равно не пустил CSP.

          Звёзды намеренно жёлтые, #FBBC04 — фирменный цвет Google, ради
          узнаваемости бейджа. На белом он даёт около 1.7:1, то есть под
          правило 4.5:1 не проходит, и это допустимо ровно потому, что они
          `aria-hidden` и ничего не сообщают: оценка стоит рядом текстом
          «5.0», плюс есть строка для скринридера. Не делайте их значащими
          (не убирайте текст рядом) — тогда цвет придётся менять.

          ⚠️ Кнопка ведёт на `/review`, а это форма написания отзыва, не
          список. Подпись «Смотреть отзывы в Google» выбрана владельцем
          осознанно; чтобы вела на карточку, замените `review` на `profile`. */}
      <div
        class="mt-6 max-w-sm rounded-[var(--radius-card)] border border-line bg-white p-5 shadow-[0_1px_2px_rgb(11_11_12/0.05),0_10px_30px_-18px_rgb(11_11_12/0.25)]"
      >
        <div class="flex items-center gap-3">
          <svg class="size-6 shrink-0" viewBox="0 0 48 48" aria-hidden="true">
            <path
              fill="#EA4335"
              d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
            ></path>
            <path
              fill="#4285F4"
              d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"
            ></path>
            <path
              fill="#FBBC05"
              d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"
            ></path>
            <path
              fill="#34A853"
              d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"
            ></path>
          </svg>

          <span class="flex gap-0.5" aria-hidden="true">
            {
              Array.from({ length: facts.google.rating }, () => (
                <svg class="size-[1.05rem]" viewBox="0 0 20 20" fill="#FBBC04">
                  <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" />
                </svg>
              ))
            }
          </span>

          <span class="text-[1.05rem] font-bold tabular-nums text-ink">
            {facts.google.rating}.0
          </span>
          {/* Число отзывов появляется, только когда оно задано в facts.
              Ставить «0 отзывов» или прочерк нельзя: пустое место читается
              лучше, чем признание, что отзывов нет. */}
          {
            facts.google.reviews !== null && (
              <span class="text-[0.9rem] text-ink-muted">
                · {facts.google.reviews} {reviewsWord(lang, facts.google.reviews)}
              </span>
            )
          }
          <span class="sr-only">{t("google.stars")}</span>
        </div>

        <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-muted">{t("google.text")}</p>

        {/* Читать отзывы — на карточку профиля. Раньше вела на /review, то
            есть на форму написания: подпись «Смотреть отзывы» обещала одно, а
            открывалось другое. Развели, когда появилась кнопка «Написать
            отзыв» ниже — иначе две кнопки вели бы на один адрес. */}
        <a
          class="mt-4 block rounded-xl border border-line-strong/60 px-4 py-2.5 text-center text-[0.9rem] font-semibold text-ink transition-colors hover:bg-page"
          href={facts.google.profile}
          target="_blank"
          rel="noopener nofollow"
        >
          {t("google.cta")}
        </a>
      </div>

      {/* Призыв оставить отзыв — отдельной заливной кнопкой под бейджем, а не
          внутри него: бейдж сообщает факт (нас оценили), кнопка просит о
          действии. Заливка нужна, чтобы её замечали: рядом в подвале всё
          остальное — ссылки и рамки. */}
      <ReviewButton lang={lang} class="mt-3 w-full max-w-sm" />
    </div>

    {/* Заголовки колонок подвала — <p>, а не <h2>.
        Подвал стоит на каждой странице, и три постоянных H2 («Контакты»,
        «Направления», «Полезное») смешивались с содержанием: на гиде из
        пятнадцати H2 пять были служебными. Роль заголовка здесь берёт на себя
        aria-label у <nav>, поэтому доступность не страдает. */}
    <div>
      <p class="text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-ink-dim">
        {t("footer.contacts")}
      </p>
      <ul class="mt-4 grid gap-2 text-[0.95rem]">
        <li><a class="hover:text-brand-ink" href={facts.phoneHref}>{facts.phone}</a></li>
        <li><a class="hover:text-brand-ink" href={`mailto:${facts.email}`}>{facts.email}</a></li>
      </ul>
      <div class="mt-3">
        <Messengers lang={lang} variant="compact" />
      </div>
    </div>

    <nav aria-label={t("footer.routes")}>
      <p class="text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-ink-dim">
        {t("footer.routes")}
      </p>
      <ul class="mt-4 grid gap-2 text-[0.95rem]">
        {
          links.routes.map((l) => (
            <li>
              <a class="hover:text-brand-ink" href={l.href}>
                {l.label}
                {l.note && <span class="text-ink-dim"> — {l.note}</span>}
              </a>
            </li>
          ))
        }
        <li>
          <a class="hover:text-brand-ink" href={`${localePath(lang, "/")}#routes`}>
            {t("footer.allRoutes")}
          </a>
        </li>
      </ul>
    </nav>

    {/* Поездки по России — отдельной колонкой: там рубли, другая машина и
        границу она не пересекает. В одном списке с евровыми маршрутами это
        читалось бы как один прайс. */}
    {
      links.russia.length > 0 && (
        <nav aria-label={t("footer.russia")}>
          <p class="text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-ink-dim">
            {t("footer.russia")}
          </p>
          <ul class="mt-4 grid gap-2 text-[0.95rem]">
            {links.russia.map((l) => (
              <li>
                <a class="hover:text-brand-ink" href={l.href}>
                  {l.label}
                  {l.note && <span class="text-ink-dim"> — {l.note}</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <nav aria-label={t("footer.useful")}>
      <p class="text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-ink-dim">
        {t("footer.useful")}
      </p>
      <ul class="mt-4 grid gap-2 text-[0.95rem]">
        {
          links.guides.map((l) => (
            <li>
              <a class="hover:text-brand-ink" href={l.href}>{l.label}</a>
            </li>
          ))
        }
        <li>
          <a class="hover:text-brand-ink" href={`${localePath(lang, "/")}#car`}>{t("nav.car")}</a>
        </li>
        <li>
          <a class="hover:text-brand-ink" href={`${localePath(lang, "/")}#faq`}>{t("nav.faq")}</a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-line" data-nosnippet>
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-start justify-between gap-2 px-5 py-5 text-[0.85rem] text-ink-dim"
    >
      <div class="grid gap-2">
        <p>© {year} EstoniaTransfer · {t("footer.rights")}</p>

        {/* Счётчик посещений: слева внизу, под копирайтом. Число подставляет
            скрипт ниже из /hits.php — без JS или без PHP строка остаётся
            скрытой, пустого «Посещений: —» посетитель не увидит.

            Про [&[hidden]]:hidden рядом с inline-flex. Скрывать элемент
            атрибутом hidden и задавать ему display утилитой — обычно конфликт:
            правило браузера для [hidden] слабее классов. Здесь его хватает,
            потому что preflight Tailwind 4 ставит [hidden]{display:none
            !important}, но полагаться на чужой !important не хочется — свой
            селектор по атрибуту специфичнее любой утилиты и не зависит от
            того, что там в preflight следующей версии. */}
        <p
          data-hits
          hidden
          class="inline-flex items-center gap-2 self-start rounded-full border border-line bg-page px-2.5 py-1 text-[0.72rem] tracking-wide [&[hidden]]:hidden"
        >
          <span class="size-1.5 rounded-full bg-brand" aria-hidden="true"></span>
          {t("footer.hits")}
          <span data-hits-value class="font-semibold text-ink-muted tabular-nums">—</span>
        </p>
      </div>

      <p>{t("footer.city")}</p>
    </div>
  </div>

  <script is:inline>
    // Считает сервер (hits.php), браузер только показывает число. Запрос идёт
    // отсюда, а не из разметки, — значит краулеры, не исполняющие JS, счётчик
    // не накручивают. Если PHP недоступен или запрос не удался, пилюля так и
    // остаётся скрытой.
    //
    // Рендер этот запрос не блокировал никогда: это fetch, а не <script src>,
    // и вешать на него defer или async не на что. Но уходил он на ~885 мс,
    // почти вровень с первой отрисовкой, и попадал в цепочку критических
    // запросов в отчёте PageSpeed. Теперь ждём load, а потом ещё и свободной
    // минуты браузера: число посещений в подвале не стоит ни одного
    // миллисекунды в борьбе за LCP.
    (function () {
      "use strict";
      var box = document.querySelector("[data-hits]");
      if (!box || !window.fetch) return;

      function load() {
        fetch("/hits.php", { credentials: "omit" })
          .then(function (res) {
            return res.ok ? res.json() : null;
          })
          .then(function (data) {
            if (!data || typeof data.total !== "number" || data.total < 1) return;
            var value = box.querySelector("[data-hits-value]");
            if (value) value.textContent = data.total.toLocaleString("ru-RU");
            box.hidden = false;
          })
          .catch(function () {
            /* молча: счётчик не та вещь, из-за которой стоит шуметь в консоли */
          });
      }

      // timeout у requestIdleCallback обязателен: на занятой вкладке свободной
      // минуты может не случиться вовсе, и посетитель остался бы без числа.
      function schedule() {
        if (window.requestIdleCallback) requestIdleCallback(load, { timeout: 3000 });
        else setTimeout(load, 1200);
      }

      if (document.readyState === "complete") schedule();
      else window.addEventListener("load", schedule, { once: true });
    })();
  </script>
</footer>
