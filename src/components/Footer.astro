---
import Messengers from "./Messengers.astro";
import { useTranslations, facts, localePath, type Lang, type UIKey } from "../i18n/ui";
import { landingHref } from "../data/routes";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="text-[1.05rem] font-semibold tracking-tight">
        Estonia<span class="text-brand-ink">Transfer</span>
      </p>
      <p class="mt-3 max-w-sm text-[0.95rem] leading-relaxed text-ink-muted">
        {t("footer.tagline")}
      </p>
    </div>

    <div>
      <h2 class="text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-ink-dim">
        {t("footer.contacts")}
      </h2>
      <ul class="mt-4 grid gap-2 text-[0.95rem]">
        <li><a class="hover:text-brand-ink" href={facts.phoneHref}>{facts.phone}</a></li>
        <li><a class="hover:text-brand-ink" href={`mailto:${facts.email}`}>{facts.email}</a></li>
      </ul>
      <div class="mt-3">
        <Messengers lang={lang} variant="compact" />
      </div>
    </div>

    <div>
      <h2 class="text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-ink-dim">
        {t("footer.routes")}
      </h2>
      <ul class="mt-4 grid gap-2 text-[0.95rem]">
        {/* Есть страница маршрута — ведём на неё: подвал стоит на каждой
            странице, и это основная перелинковка сайта. Нет — на блок цен. */}
        {
          facts.routes.map((r) => (
            <li>
              <a
                class="hover:text-brand-ink"
                href={landingHref(lang, r.id) ?? `${localePath(lang, "/")}#routes`}
              >
                {t(`routes.${r.id}` as UIKey)} — {r.price} €
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div
      class="mx-auto flex max-w-6xl flex-wrap justify-between gap-2 px-5 py-5 text-[0.85rem] text-ink-dim"
    >
      <p>© {year} EstoniaTransfer · {t("footer.rights")}</p>
      <p>{t("footer.city")}</p>
    </div>
  </div>
</footer>
