---
import LangSwitcher from "./LangSwitcher.astro";
import BrandIcon from "./BrandIcon.astro";
import { useTranslations, facts, localePath, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  path?: string;
  /** языки, на которых существует текущая страница — для переключателя */
  langs?: Lang[];
  /** свой путь у языка, если слаг переведён — см. `paths` в Base.astro */
  paths?: Partial<Record<Lang, string>>;
}
const { lang, path = "/", langs, paths } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang, "/");
---

<header
  class="sticky top-0 z-40 border-b border-line/80 bg-page/80 backdrop-blur-xl backdrop-saturate-150"
>
  {/* min-h фиксирует высоту строки. Без него высота шапки складывалась из
      самого высокого ребёнка, а состав детей меняется: кнопка с телефоном
      появляется только с sm, переключатель языков растёт при открытии. Любая
      такая перемена смещала содержимое страницы вниз. */}
  {/* gap-3 до lg, а не gap-4 везде: с появлением пары мессенджеров строка на
      планшете (768–1023 px, где уже видна навигация) шла впритык. На широких
      экранах место есть, там прежние gap-4 и gap-7. */}
  <div class="mx-auto flex min-h-[4.25rem] max-w-6xl items-center gap-3 px-5 py-3.5 lg:gap-4">
    <a href={home} class="flex shrink-0 items-center gap-2.5 font-semibold tracking-tight">
      <span
        class="grid size-9 place-items-center rounded-xl bg-brand text-ink"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" fill="none" width="20" height="20" class="size-5">
          <path
            d="M3 15.5h18M6 15.5v2.2M18 15.5v2.2M4.2 15.5l1.9-6.1A2.5 2.5 0 0 1 8.5 7.6h7a2.5 2.5 0 0 1 2.4 1.8l1.9 6.1"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path>
        </svg>
      </span>
      <span class="text-[1.05rem]">Estonia<span class="text-brand-ink">Transfer</span></span>
    </a>

    <nav class="ml-auto hidden items-center gap-6 whitespace-nowrap text-[0.95rem] text-ink-muted md:flex lg:gap-7" aria-label={lang === "ru" ? "Основная навигация" : "Main navigation"}>
      <a class="transition-colors hover:text-ink" href={`${home}#routes`}>{t("nav.routes")}</a>
      <a class="transition-colors hover:text-ink" href={`${home}#car`}>{t("nav.car")}</a>
      <a class="transition-colors hover:text-ink" href={`${home}#order`}>{t("nav.order")}</a>
    </nav>

    {/* ml-auto до md, потом снимаем: ниже md навигация скрыта, и без этого
        переключатель с мессенджерами прижимались к логотипу, а правая половина
        шапки пустовала. С md отступ убираем — там ml-auto уже у навигации, а
        два auto-отступа в одной строке делят свободное место пополам и уводят
        навигацию к середине. */}
    <div class="ml-auto shrink-0 md:ml-0"><LangSwitcher lang={lang} path={path} langs={langs} paths={paths} /></div>

    {/* Мессенджеры вплотную к телефону: заказ идёт в них, а не через форму, и
        путь к ним не должен начинаться с прокрутки до подвала. Ссылки прямые —
        те же facts.whatsapp и facts.telegram, что и везде на сайте, номер в
        разметке не дублируется.

        Видны на телефоне, где кнопка с номером скрыта и место справа всё равно
        пустовало: написать в мессенджер с телефона — основной сценарий.

        Две дырки в диапазоне ширин не от лени, а по замерам (DevTools
        Protocol, ширина эмулируется по-настоящему):
        - ниже 360 px строка не вмещает логотип, переключатель языка и пару
          значков: на 320 px не хватает трёх десятков пикселей, и появился бы
          горизонтальный скролл;
        - от 768 до 1023 px рядом стоит навигация шириной 274 px, и на 768 px
          строка вылезала на 20 px — кнопка с номером упиралась в край без
          отступа. С lg места снова хватает.
        Проверять правки здесь — только замером, на глаз ошибиться легко.

        Цвет фирменный, зелёный и синий: узнаваемость логотипа здесь важнее
        единообразия, а WCAG к логотипам требований по контрасту не предъявляет.
        Имя ссылки задано aria-label — сама иконка для скринридера скрыта. */}
    <div class="hidden shrink-0 items-center gap-1 min-[360px]:flex md:hidden lg:flex">
      <a
        href={facts.whatsapp}
        target="_blank"
        rel="noopener"
        aria-label={lang === "ru" ? "Написать в WhatsApp" : "Message us on WhatsApp"}
        class="grid size-8 place-items-center rounded-xl border border-line-strong/50 text-[#25D366] transition-colors hover:bg-surface"
      >
        <BrandIcon name="whatsapp" class="size-4" />
      </a>
      <a
        href={facts.telegram}
        target="_blank"
        rel="noopener"
        aria-label={lang === "ru" ? "Написать в Telegram" : "Message us on Telegram"}
        class="grid size-8 place-items-center rounded-xl border border-line-strong/50 text-[#26A5E4] transition-colors hover:bg-surface"
      >
        <BrandIcon name="telegram" class="size-4" />
      </a>
    </div>

    <a
      href={facts.phoneHref}
      class="hidden shrink-0 rounded-xl bg-brand px-4 py-2.5 text-[0.95rem] font-semibold text-ink transition-colors hover:bg-brand-hover sm:block"
    >
      {facts.phone}
    </a>
  </div>
</header>
