---
import LangSwitcher from "./LangSwitcher.astro";
import { useTranslations, facts, localePath, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  path?: string;
  /** языки, на которых существует текущая страница — для переключателя */
  langs?: Lang[];
}
const { lang, path = "/", langs } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang, "/");
---

<header
  class="sticky top-0 z-40 border-b border-line/80 bg-page/80 backdrop-blur-xl backdrop-saturate-150"
>
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-5 py-3.5">
    <a href={home} class="flex items-center gap-2.5 font-semibold tracking-tight">
      <span
        class="grid size-9 place-items-center rounded-xl bg-brand text-ink"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" fill="none" class="size-5">
          <path
            d="M3 15.5h18M6 15.5v2.2M18 15.5v2.2M4.2 15.5l1.9-6.1A2.5 2.5 0 0 1 8.5 7.6h7a2.5 2.5 0 0 1 2.4 1.8l1.9 6.1"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path>
        </svg>
      </span>
      <span class="text-[1.05rem]">Estonia<span class="text-brand-ink">Transfer</span></span>
    </a>

    <nav class="ml-auto hidden items-center gap-7 text-[0.95rem] text-ink-muted md:flex" aria-label={lang === "ru" ? "Основная навигация" : "Main navigation"}>
      <a class="transition-colors hover:text-ink" href={`${home}#routes`}>{t("nav.routes")}</a>
      <a class="transition-colors hover:text-ink" href={`${home}#car`}>{t("nav.car")}</a>
      <a class="transition-colors hover:text-ink" href={`${home}#order`}>{t("nav.order")}</a>
    </nav>

    <LangSwitcher lang={lang} path={path} langs={langs} />

    <a
      href={facts.phoneHref}
      class="hidden rounded-xl bg-brand px-4 py-2.5 text-[0.95rem] font-semibold text-ink transition-colors hover:bg-brand-hover sm:block"
    >
      {facts.phone}
    </a>
  </div>
</header>
