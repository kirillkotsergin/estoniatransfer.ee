---
/**
 * Панель связи внизу экрана на телефоне (02.10.2026) — заменила плавающую
 * кнопку «Заказать» с модалкой. Та перекрывала текст: карточки доверия,
 * бейдж Google, строку «Таллинн, Эстония» в подвале.
 *
 * Две кнопки, без промежуточного окна: заказ идёт в WhatsApp или звонком,
 * лишний клик на телефоне — потерянная заявка. Отступ снизу под панель задан
 * у <body> в Base.astro (max-md:pb-…), поэтому она ничего не перекрывает.
 *
 * Только до md: от 768 px связь видна в липкой шапке (телефон, мессенджеры).
 *
 * Контраст: тёмный текст на зелёном WhatsApp — 9.92 (белый дал бы 1.98),
 * белый на night — 17.46. Адреса — из facts, конверсию Google Ads по ним
 * обработчик в Base.astro засчитает сам.
 */
import BrandIcon from "./BrandIcon.astro";
import { useTranslations, facts, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const tgHref = facts.telegramUser ? `https://t.me/${facts.telegramUser}` : facts.telegram;
const btn ="flex min-h-12 items-center justify-center gap-2 rounded-2xl px-4 font-semibold";
---

<nav
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line/80 bg-page/90 px-3 pt-2.5 backdrop-blur-xl backdrop-saturate-150 md:hidden"
  style="padding-bottom: max(0.625rem, env(safe-area-inset-bottom))"
  aria-label={t("bar.label")}
  data-nosnippet
>
  <div class="mx-auto grid max-w-md grid-cols-2 gap-2.5">
    <a href={facts.whatsapp} target="_blank" rel="noopener" class={`${btn} bg-[#25d366] text-ink active:bg-[#20bd5c]`}>
      <BrandIcon name="whatsapp" class="size-5 shrink-0" />
      WhatsApp
    </a>
    {/* Telegram вместо «Позвонить» (02.10.2026, решение владельца). Синий —
        #1677B8, а не фирменный #2AABEE: белый текст на #2AABEE даёт 2.57,
        на #1677B8 — 4.81, норма сайта 4.5. Адрес — по имени из
        facts.telegramUser, его же засчитывает конверсия в Base.astro. */}
    <a href={tgHref} target="_blank" rel="noopener" class={`${btn} bg-[#1677B8] text-white active:bg-[#136CA8]`}>
      <BrandIcon name="telegram" class="size-5 shrink-0" />
      Telegram
    </a>
  </div>
</nav>
