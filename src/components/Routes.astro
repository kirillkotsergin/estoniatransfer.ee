---
import { useTranslations, facts, type Lang, type UIKey } from "../i18n/ui";
import { landingHref } from "../data/routes";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="routes" class="scroll-mt-24 border-t border-line bg-surface py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-5">
    <header class="max-w-2xl">
      <p class="reveal text-[0.82rem] font-semibold uppercase tracking-[0.16em] text-brand-ink">
        {t("routes.eyebrow")}
      </p>
      <h2
        class="reveal mt-4 text-[clamp(1.9rem,3.6vw,2.9rem)] font-semibold leading-tight tracking-[-0.02em]"
        style="--d:1"
      >
        {t("routes.title")}
      </h2>
      <p class="reveal mt-4 text-ink-muted" style="--d:2">{t("routes.lead")}</p>
    </header>

    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        facts.routes.map((r, i) => (
          <li
            class="reveal glass flex flex-col rounded-[--radius-card] p-6"
            style={`--d:${i + 1}`}
          >
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="text-lg font-semibold tracking-tight">
                {t(`routes.${r.id}` as UIKey)}
              </h3>
              <p class="text-2xl font-semibold tracking-tight">
                {r.price} €
              </p>
            </div>
            <p class="mt-1 text-[0.82rem] text-ink-dim">{t("common.perCar")}</p>
            <p class="mt-4 text-[0.95rem] leading-relaxed text-ink-muted">
              {t(`routes.${r.id}.note` as UIKey)}
            </p>
            <dl class="mt-5 flex gap-6 border-t border-line pt-4 text-[0.88rem]">
              <div>
                <dt class="text-ink-dim">{t("routes.km")}</dt>
                <dd class="font-semibold">{r.km}</dd>
              </div>
              <div>
                <dt class="text-ink-dim">{t("routes.time")}</dt>
                <dd class="font-semibold">{lang === "ru" ? r.hours : r.hoursEn}</dd>
              </div>
            </dl>

            {/* Ссылка на страницу маршрута. Пока такой страницы нет — ссылки
                тоже нет: landingHref вернёт null, а не битый адрес. */}
            {
              landingHref(lang, r.id) && (
                <a
                  href={landingHref(lang, r.id)}
                  class="mt-4 inline-flex items-center gap-1.5 text-[0.93rem] font-semibold text-brand-ink hover:underline"
                >
                  {t("routes.more")}
                  <span aria-hidden="true">→</span>
                </a>
              )
            }
          </li>
        ))
      }
    </ul>

    {/* Доплата за место в очереди: отдельной полосой, а не строкой в карточке —
        иначе её читают как часть цены маршрута. */}
    <div
      class="reveal mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 rounded-[--radius-card] border border-brand/35 bg-brand-soft px-6 py-5"
      style="--d:4"
    >
      <p class="text-2xl font-semibold tracking-tight text-brand-ink">
        +{facts.queueSlot.price} €
      </p>
      <div class="min-w-56 flex-1">
        <h3 class="font-semibold tracking-tight">{t("addon.title")}</h3>
        <p class="mt-1 text-[0.93rem] leading-relaxed text-ink-muted">{t("addon.text")}</p>
      </div>
    </div>

    <p class="reveal mt-6 text-[0.95rem] text-ink-muted" style="--d:5">{t("routes.other")}</p>
  </div>
</section>
