---
/**
 * Блок «Направления и цены» — карточки маршрутов и полоса доплаты.
 *
 * Что здесь важно понимать про цвет. В макете цена и кнопка выкрашены ярким
 * брендовым оранжевым (#ff6a00) с белым текстом. Так делать нельзя, и это не
 * вкусовщина: белый на этом оранжевом даёт контраст 2.87:1 против нормы 4.5,
 * то есть проваливает WCAG AA, а PageSpeed показывает это отдельным пунктом.
 * Поэтому в палитре два оранжевых с разными ролями (см. начало global.css):
 *   --color-brand      заливка, текст поверх неё тёмный  → кнопка
 *   --color-brand-ink  буквы на белом, 4.85:1            → цена
 * Визуально почти то же самое, что в макете, но читается всеми и проходит AA.
 *
 * Остальное сделано как в макете: цена оранжевым и крупно, цифры маршрута —
 * пилюлями с иконками, вместо текстовой ссылки полноширинная кнопка, у
 * «Койдулы» рамка и бейдж «часто выбирают», внизу карточки декоративная линия
 * маршрута. Полоса доплаты получила переключатель, и он настоящий: включаете —
 * в заявке отмечается место в очереди (см. OrderForm и send.php).
 */
import { useTranslations, facts, type Lang, type UIKey } from "../i18n/ui";
import { landingHref } from "../data/routes";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="routes" class="scroll-mt-24 border-t border-line bg-surface py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-5">
    <header class="max-w-2xl">
      <p class="reveal text-[0.82rem] font-semibold uppercase tracking-[0.16em] text-brand-ink">
        {t("routes.eyebrow")}
      </p>
      <h2
        class="reveal mt-4 text-[clamp(1.9rem,3.6vw,2.9rem)] font-semibold leading-tight tracking-[-0.02em]"
        style="--d:1"
      >
        {t("routes.title")}
      </h2>
      <p class="reveal mt-4 text-ink-muted" style="--d:2">{t("routes.lead")}</p>
    </header>

    <ul class="mt-10 grid items-start gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        facts.routes.map((r, i) => {
          const href = landingHref(lang, r.id);
          return (
            <li
              class:list={[
                "reveal glass relative flex flex-col overflow-hidden rounded-[--radius-card] p-6 transition-transform hover:-translate-y-1",
                // Выделенная карточка: рамка бренда и лёгкое свечение. Только
                // рамкой, без заливки — заливка утащила бы за собой белый текст.
                r.popular && "ring-2 ring-brand ring-offset-2 ring-offset-surface",
              ]}
              style={`--d:${i + 1}`}
            >
              {r.popular && (
                // Бейдж мелкий, поэтому не оранжевым по нежному фону (4.45 —
                // ниже нормы), а тёмным по заливке бренда: 6.85 и заметнее.
                <p class="absolute right-5 top-5 rounded-full bg-brand px-2.5 py-1 text-[0.7rem] font-semibold uppercase tracking-wide text-ink">
                  {t("routes.popular")}
                </p>
              )}

              <h3 class="pr-24 text-lg font-semibold tracking-tight">
                {t(`routes.${r.id}` as UIKey)}
              </h3>

              {/* Цена крупно и оранжевым — главный элемент карточки */}
              <p class="mt-3 text-[2.1rem] font-semibold leading-none tracking-tight text-brand-ink">
                {r.price} €
              </p>
              <p class="mt-1.5 text-[0.82rem] text-ink-dim">{t("common.perCar")}</p>

              <p class="mt-4 text-[0.95rem] leading-relaxed text-ink-muted">
                {t(`routes.${r.id}.note` as UIKey)}
              </p>

              {/* Цифры маршрута — пилюлями с иконками, как в макете */}
              <dl class="mt-5 grid grid-cols-2 gap-2.5 text-[0.85rem]">
                <div class="flex items-center gap-2 rounded-xl border border-line bg-page px-3 py-2">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    width="18"
                    height="18"
                    class="size-4.5 shrink-0 text-brand-ink"
                    aria-hidden="true"
                  >
                    <path
                      d="M12 20a8 8 0 1 1 8-8"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                    />
                    <path
                      d="m12 12 4-3"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                    />
                  </svg>
                  <span class="min-w-0">
                    <dt class="text-[0.72rem] leading-none text-ink-dim">{t("routes.km")}</dt>
                    <dd class="mt-1 font-semibold leading-none">{r.km}</dd>
                  </span>
                </div>

                <div class="flex items-center gap-2 rounded-xl border border-line bg-page px-3 py-2">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    width="18"
                    height="18"
                    class="size-4.5 shrink-0 text-brand-ink"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.8" />
                    <path
                      d="M12 8.4V12l2.6 1.8"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                    />
                  </svg>
                  <span class="min-w-0">
                    <dt class="text-[0.72rem] leading-none text-ink-dim">{t("routes.time")}</dt>
                    <dd class="mt-1 font-semibold leading-none">
                      {lang === "ru" ? r.hours : r.hoursEn}
                    </dd>
                  </span>
                </div>
              </dl>

              {/* Кнопка приглушённая: заливка нежная, текст оранжевый. Ярким
                  #ff6a00 на карточках она перетягивала внимание на себя — этих
                  кнопок три в ряд, и рядом с ними теряются и цена, и главный
                  призыв на странице. Насыщенный оранжевый остаётся у действий,
                  которые ведут к заказу: кнопка в герое, плавающая кнопка,
                  «Отправить заявку».

                  Контраст проверен: оранжевый текст по нежной подложке 4.68,
                  при наведении заливка становится яркой, а текст тёмным — 6.85.
                  Белого текста на оранжевом здесь по-прежнему нет нигде. */}
              <a
                href={href ?? "#order"}
                class="mt-6 flex items-center justify-center rounded-2xl border border-brand/40 bg-brand-soft px-4 py-3 text-[0.82rem] font-semibold uppercase tracking-[0.06em] text-brand-ink-soft transition-colors hover:bg-brand hover:text-ink"
              >
                {t("routes.more")}
              </a>

              {/* Декор: условная линия маршрута с двумя точками. Не карта и не
                  претендует ею быть — просто подпись «это дорога из А в Б». */}
              <svg
                viewBox="0 0 240 44"
                fill="none"
                class="mt-5 h-11 w-full text-brand/35"
                aria-hidden="true"
              >
                <path
                  d="M14 30C48 30 60 12 96 12s52 20 88 20"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-dasharray="1 7"
                />
                <path
                  d="M14 30C48 30 60 12 96 12"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                />
                <circle cx="14" cy="30" r="4.5" fill="currentColor" />
                <circle cx="226" cy="30" r="4.5" stroke="currentColor" stroke-width="2.4" />
              </svg>
            </li>
          );
        })
      }
    </ul>

    {/* Доплата за место в очереди: отдельной полосой, а не строкой в карточке —
        иначе её читают как часть цены маршрута. Переключатель настоящий: он
        отмечает опцию в форме заявки ниже и подсвечивается, когда включён. */}
    <div
      class="reveal mt-6 flex flex-wrap items-center gap-x-6 gap-y-4 rounded-[--radius-card] border border-brand/35 bg-brand-soft px-6 py-5"
      style="--d:4"
    >
      {/* На нежной подложке нужен более тёмный оттенок — см. global.css */}
      <p class="text-[2.1rem] font-semibold leading-none tracking-tight text-brand-ink-soft">
        +{facts.queueSlot.price} €
      </p>

      <span
        class="grid size-11 shrink-0 place-items-center rounded-full border border-brand/40 text-brand-ink-soft"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" fill="none" width="22" height="22" class="size-5.5">
          <circle cx="12" cy="12" r="8.4" stroke="currentColor" stroke-width="1.8" />
          <path
            d="m8.4 12.2 2.4 2.4 4.8-5"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>

      <div class="min-w-56 flex-1">
        <h3 class="font-semibold tracking-tight">{t("addon.title")}</h3>
        <p class="mt-1 text-[0.93rem] leading-relaxed text-ink-muted">{t("addon.text")}</p>
      </div>

      {/* Переключатель на чекбоксе: работает с клавиатуры и без JS остаётся
          обычным полем. Скрипт лишь синхронизирует его с формой заявки. */}
      <label
        class="group flex shrink-0 cursor-pointer items-center gap-3 text-[0.78rem] font-semibold uppercase tracking-[0.06em] text-ink"
        data-addon-toggle
      >
        <input type="checkbox" class="peer sr-only" data-addon-input />
        <span
          class="relative h-7 w-12 shrink-0 rounded-full bg-ink/15 transition-colors peer-checked:bg-brand peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink"
          aria-hidden="true"
        >
          <span
            class="absolute left-1 top-1 size-5 rounded-full bg-page shadow transition-transform group-has-[:checked]:translate-x-5"
          ></span>
        </span>
        <span data-addon-label>{t("addon.toggle")}</span>
      </label>
    </div>

    <p class="reveal mt-6 text-[0.95rem] text-ink-muted" style="--d:5">{t("routes.other")}</p>

    {/* Написания на втором алфавите — видимой строкой, а не скрытым текстом:
        скрытые ключевые слова Google считает нарушением и снимает страницу.
        Строка полезна и людям: на билетах и указателях названия латиницей. */}
    <p class="reveal mt-3 text-[0.9rem] text-ink-dim" style="--d:6">{t("routes.latin")}</p>
  </div>
</section>

<script is:inline define:vars={{ labels: { off: t("addon.toggle"), on: t("addon.added") } }}>
  // Переключатель доплаты синхронизирован с чекбоксом в форме заявки: включили
  // здесь — опция отмечена там, и она уезжает в письмо. Без скрипта это просто
  // отдельное поле, страница не ломается.
  (function () {
    "use strict";
    var toggle = document.querySelector("[data-addon-input]");
    var label = document.querySelector("[data-addon-label]");
    if (!toggle) return;

    function sync() {
      var field = document.querySelector("[data-order-queue]");
      if (field) field.checked = toggle.checked;
      if (label) label.textContent = toggle.checked ? labels.on : labels.off;
    }

    toggle.addEventListener("change", sync);

    // Обратная связь: отметили в форме — переключатель тоже встаёт
    document.addEventListener("change", function (e) {
      if (e.target && e.target.hasAttribute && e.target.hasAttribute("data-order-queue")) {
        toggle.checked = e.target.checked;
        if (label) label.textContent = toggle.checked ? labels.on : labels.off;
      }
    });
  })();
</script>
