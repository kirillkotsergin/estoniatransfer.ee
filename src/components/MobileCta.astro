---
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

{/* Кнопка «Заказать» в правом нижнем углу, только на мобильных (md:hidden).
    padding-bottom с safe-area — иначе на iPhone кнопка уезжает под полосу
    жестов. Прячется, когда блок заявки сам на экране: перекрывать форму,
    к которой она ведёт, бессмысленно. */}
<a
  href="#order"
  data-mobile-cta
  class="fixed bottom-4 right-4 z-50 flex items-center gap-2 rounded-full bg-brand px-5 py-3.5 font-semibold text-ink shadow-[0_10px_30px_-8px_rgb(11_11_12/0.45)] transition-all duration-300 md:hidden"
  style="padding-bottom: max(0.875rem, env(safe-area-inset-bottom))"
>
  <svg viewBox="0 0 24 24" fill="none" class="size-5" aria-hidden="true">
    <path
      d="M6.6 3.5h2.9l1.5 3.7-2 1.3a11 11 0 0 0 5 5l1.3-2 3.7 1.5v2.9a1.6 1.6 0 0 1-1.8 1.6A15.6 15.6 0 0 1 5 5.3 1.6 1.6 0 0 1 6.6 3.5Z"
      fill="currentColor"></path>
  </svg>
  {t("nav.order")}
</a>

<script is:inline>
  (function () {
    "use strict";
    var cta = document.querySelector("[data-mobile-cta]");
    var order = document.getElementById("order");
    if (!cta || !order || !("IntersectionObserver" in window)) return;
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          var hide = e.isIntersecting;
          cta.style.opacity = hide ? "0" : "1";
          cta.style.transform = hide ? "translateY(120%)" : "translateY(0)";
          cta.style.pointerEvents = hide ? "none" : "auto";
          cta.setAttribute("aria-hidden", hide ? "true" : "false");
        });
      },
      { threshold: 0.12 }
    );
    io.observe(order);
  })();
</script>
