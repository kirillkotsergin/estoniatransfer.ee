---
/**
 * Микроразметка главной страницы: один граф вместо россыпи отдельных блоков.
 *
 * Расчёт не только на сниппеты Google, но и на языковые модели: ChatGPT, Claude
 * и Gemini разбирают JSON-LD как готовые факты и цитируют их охотнее, чем
 * абзацы. Поэтому здесь явно, полями, а не прозой: кто оказывает услугу, куда
 * возит, сколько это стоит, сколько километров и часов, по какому телефону
 * связаться и на каком языке ответят.
 *
 * Что важно в структуре:
 * - у организации тип двойной, `["LocalBusiness","TaxiService"]`. TaxiService в
 *   schema.org не наследник LocalBusiness, а отдельная ветка, поэтому один тип
 *   пришлось бы выбирать: либо «локальный бизнес», либо «услуга такси».
 *   Массив даёт и то, и другое.
 * - `@id` проставлены всем сущностям, и страницы маршрутов ссылаются на бизнес
 *   через `provider: { "@id": … }`, а не описывают его заново. Для модели это
 *   один и тот же субъект на всём сайте, а не пять похожих.
 * - у каждого оффера `itemOffered` — это Service с `departureLocation` и
 *   `arrivalLocation`. Пара «откуда — куда» в отдельных полях читается
 *   машиной однозначно, в отличие от строки «Таллинн — Нарва».
 * - расстояние и время едут в `additionalProperty` как QuantitativeValue с
 *   единицами: KMT (километры) и MIN (минуты). Это стандартный способ отдать
 *   число, для которого в схеме нет своего поля.
 *
 * Чего здесь намеренно нет:
 * - `address` — точного адреса офиса у сервиса нет, а выдумывать его нельзя:
 *   несуществующий адрес в разметке хуже отсутствующего.
 * - `aggregateRating` — отзывов нет. Рейтинг без отзывов Google считает
 *   нарушением и снимает расширенные сниппеты со всего сайта.
 *
 * ПРОВЕРЬ: `availableLanguage` — ru и en. Если водитель говорит по-эстонски,
 * допишите `et`: по этому полю ассистенты отвечают на вопрос «а на каком языке
 * с ними можно?».
 */
import { getImage } from "astro:assets";
import bizPhoto from "../assets/car/car-1.jpg";
import { facts, localePath, siteUpdated, type Lang } from "../i18n/ui";
import { landingsFor } from "../data/routes";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const site = Astro.site?.origin ?? "https://estoniatransfer.ee";
const home = new URL(localePath(lang, "/"), site).href;
const org = `${site}/#business`;
const phone = facts.phoneHref.replace("tel:", "");

/**
 * Фотографии бизнеса. Раньше здесь стояла favicon-192x192.png — иконка 192×192
 * в роли снимка: формально поле заполнено, а показать по нему нечего.
 *
 * Три пропорции одного кадра, как на страницах маршрутов: в разных местах
 * выдачи карточка обрезается по-разному, и без нужной пропорции Google режет
 * сам, иногда по машине. Файлы те же самые, что уже собраны для Product на
 * страницах маршрутов, — Astro отдаёт их из кеша, новых картинок не появится.
 */
const bizImages = await Promise.all(
  [
    [1200, 1200],
    [1200, 900],
    [1200, 675],
  ].map(([width, height]) =>
    getImage({ src: bizPhoto, width, height, fit: "cover", position: "center", format: "jpeg" })
  )
).then((list) => list.map((img: { src: string }) => new URL(img.src, site).href));

/** Города и переходы на двух языках: в разметке имя должно быть на языке страницы. */
const place = {
  tallinn: { ru: "Таллинн", en: "Tallinn" },
  tartu: { ru: "Тарту", en: "Tartu" },
  narva: { ru: "Нарва", en: "Narva" },
  koidula: { ru: "Койдула", en: "Koidula" },
  luhamaa: { ru: "Лухамаа", en: "Luhamaa" },
} as const;

const routeName = {
  narva: { ru: "Трансфер Таллинн — Нарва", en: "Transfer Tallinn — Narva" },
  koidula: { ru: "Трансфер Таллинн — Койдула", en: "Transfer Tallinn — Koidula" },
  luhamaa: { ru: "Трансфер Таллинн — Лухамаа", en: "Transfer Tallinn — Luhamaa" },
} as const;

const t = {
  ru: {
    desc: "Индивидуальный трансфер из Таллинна к погранпереходам Нарва, Койдула и Лухамаа: фиксированная цена за автомобиль, встреча в аэропорту и круизном порту, выезд в любое время суток.",
    catalog: "Направления и цены",
    booking: "заказ трансфера",
    payment: "Наличные, банковский перевод",
    car: "трансфер к погранпереходу, до 4 пассажиров с багажом",
    queue: "Место в очереди на границе",
    queueDesc: "Бронирование времени в очереди на выезд, доплата к маршруту в Нарву",
    fromTartu: "Трансфер из Тарту к погранпереходам Койдула и Лухамаа",
    distance: "Расстояние",
    duration: "Время в пути",
    licence: "Лицензия на перевозку пассажиров",
  },
  en: {
    desc: "Private transfer from Tallinn to the Narva, Koidula and Luhamaa border crossings: a fixed price per car, airport and cruise port pickup, departures at any hour.",
    catalog: "Routes and fares",
    booking: "transfer booking",
    payment: "Cash, bank transfer",
    car: "transfer to a border crossing, up to 4 passengers with luggage",
    queue: "A booked slot in the border queue",
    queueDesc: "Reserving a place in the exit queue, charged on top of the Narva route",
    fromTartu: "Transfer from Tartu to the Koidula and Luhamaa border crossings",
    distance: "Distance",
    duration: "Journey time",
    licence: "Passenger transport licence",
  },
}[lang];

/** Ссылка на страницу маршрута, если она на этом языке есть. */
const routeUrl = (id: string) => {
  const found = landingsFor(lang).find((r) => r.routeId === id);
  return found ? new URL(localePath(lang, `/${found.slug}/`), site).href : `${home}#routes`;
};

const quantity = (name: string, value: number, unitCode: "KMT" | "MIN") => ({
  "@type": "PropertyValue",
  name,
  value: { "@type": "QuantitativeValue", value, unitCode },
});

/** Минуты из строки «3 ч 5 мин» — для additionalProperty нужно число. */
const minutes = (id: (typeof facts.routes)[number]["id"]) =>
  ({ narva: 150, koidula: 185, luhamaa: 190 })[id];

// Тип задан явно: без него TypeScript выводит из первого map узкий литерал и
// потом не даёт дописать в массив оффер другой формы.
const offers: Record<string, unknown>[] = facts.routes.map((r) => ({
  "@type": "Offer",
  "@id": `${routeUrl(r.id)}#offer`,
  name: routeName[r.id][lang],
  price: String(r.price),
  priceCurrency: "EUR",
  availability: "https://schema.org/InStock",
  url: routeUrl(r.id),
  priceSpecification: {
    "@type": "PriceSpecification",
    price: String(r.price),
    priceCurrency: "EUR",
    valueAddedTaxIncluded: true,
    description: t.car,
  },
  itemOffered: {
    "@type": "Service",
    name: routeName[r.id][lang],
    serviceType: "Private transfer",
    provider: { "@id": org },
    departureLocation: { "@type": "City", name: place.tallinn[lang] },
    arrivalLocation: { "@type": "Place", name: place[r.id][lang] },
    additionalProperty: [
      quantity(t.distance, r.km, "KMT"),
      quantity(t.duration, minutes(r.id), "MIN"),
    ],
  },
}));

// Доплата за очередь и маршрут из Тарту — отдельные офферы: у них своя цена,
// и модели важно не смешать их с ценой основного маршрута.
offers.push({
  "@type": "Offer",
  "@id": `${routeUrl("narva")}#queue-offer`,
  name: t.queue,
  price: String(facts.queueSlot.price),
  priceCurrency: "EUR",
  availability: "https://schema.org/InStock",
  url: routeUrl("narva"),
  priceSpecification: {
    "@type": "PriceSpecification",
    price: String(facts.queueSlot.price),
    priceCurrency: "EUR",
    valueAddedTaxIncluded: true,
    description: t.queueDesc,
  },
});

const tartuPage = landingsFor(lang).find((r) => r.slug === "transfer-tartu-koidula-luhamaa");
if (tartuPage) {
  const url = new URL(localePath(lang, `/${tartuPage.slug}/`), site).href;
  offers.push({
    "@type": "Offer",
    "@id": `${url}#offer`,
    name: t.fromTartu,
    price: String(facts.fromTartu.price),
    priceCurrency: "EUR",
    availability: "https://schema.org/InStock",
    url,
    itemOffered: {
      "@type": "Service",
      name: t.fromTartu,
      serviceType: "Private transfer",
      provider: { "@id": org },
      departureLocation: { "@type": "City", name: place.tartu[lang] },
      arrivalLocation: { "@type": "Place", name: place.koidula[lang] },
      additionalProperty: [
        quantity(t.distance, facts.fromTartu.koidula.km, "KMT"),
        quantity(t.duration, 60, "MIN"),
      ],
    },
  });
}

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      // Двойной тип: и локальный бизнес, и услуга такси — см. комментарий выше
      "@type": ["LocalBusiness", "TaxiService"],
      "@id": org,
      name: "EstoniaTransfer",
      // Бренд и юрлицо — не одно и то же, и schema.org их различает: name это
      // то, как нас называют, legalName — кто отвечает по договору. Для модели
      // второе и есть то, что можно проверить во внешнем реестре.
      legalName: facts.legal.name,
      url: `${site}/`,
      description: t.desc,
      telephone: phone,
      email: facts.email,
      image: bizImages,
      priceRange: `${facts.fromTartu.price}–${Math.max(...facts.routes.map((r) => r.price))} €`,
      // Рубли здесь не для красоты: на обратных маршрутах от границы расчёт
      // рублями заявлен прямым текстом на страницах и в llms.txt, а поездки по
      // российской стороне в рублях и считаются. Факт обязан совпадать на
      // всех поверхностях — сайт, разметка, карточка Google.
      currenciesAccepted: "EUR, RUB",
      paymentAccepted: t.payment,
      // Языки водителя отдельным полем. Уже заявлены в llms.txt и в блоке про
      // водителя, но там это проза — модель вытащит её хуже, чем свойство.
      knowsLanguage: ["ru", "en"],
      // Мессенджеры — это и есть профили сервиса на стороне: другого способа
      // связаться нет, поэтому они стоят в sameAs, а не только ссылками.
      //
      // Профиль Google Business добавлен 13.09.2026 — это главный сигнал, что
      // сайт и карточка на Картах один субъект, а не два похожих бизнеса.
      // Именно sameAs, а не hasMap: hasMap описывает карту объекта, а нам
      // нужно тождество сущностей.
      //
      // ⚠️ aggregateRating сюда НЕ добавляем, даже когда на карточке пятёрки.
      // Во-первых, рейтинг с чужой площадки в своей разметке — не тот
      // источник, который Google засчитывает. Во-вторых, для LocalBusiness он
      // прямо не даёт звёзд за отзывы о себе на своём же сайте: «If the entity
      // that's being reviewed controls the reviews about itself, their pages
      // are ineligible for star review feature». Звёзды в выдаче даёт сама
      // карточка Google, а не разметка — и она их уже даёт.
      sameAs: [facts.whatsapp, facts.telegram, facts.google.profile],
      /**
       * hasMap добавлен 14.09.2026. Выше написано «именно sameAs, а не hasMap»,
       * и это остаётся верным по смыслу: тождество сущностей заявляет sameAs.
       * Но одно другому не мешает — hasMap описывает карту этого места, это
       * законное свойство LocalBusiness, и оно даёт вторую, независимую
       * привязку к той же карточке. Стоят оба, каждое в своей роли.
       */
      hasMap: facts.google.profile,
      /**
       * Идентификаторы карточки машиночитаемо. Ссылка в sameAs требует от
       * разборщика догадаться, что `cid=` в URL — это идентификатор; здесь он
       * лежит явно и с названием системы.
       *
       * Регистрационный код добавлен 23.09.2026, когда владелец его назвал:
       * для LLM проверяемое юридическое лицо — сильнейший маркер доверия из
       * всех, что вообще можно отдать разметкой.
       *
       * Через PropertyValue, а не taxID: registrikood — это номер в
       * коммерческом регистре, а не налоговый. Для KMKR у schema.org есть
       * отдельное vatID, и когда номер появится, он пойдёт туда, а не сюда.
       */
      identifier: [
        {
          "@type": "PropertyValue",
          propertyID: "Google Maps CID",
          value: facts.google.cid,
        },
        {
          "@type": "PropertyValue",
          propertyID: "EE:registrikood",
          name: "Estonian Business Registry Code",
          value: facts.legal.registryCode,
        },
      ],
      /**
       * Лицензия на перевозку пассажиров. hasCredential — штатное свойство
       * Organization ровно для этого, а EducationalOccupationalCredential с
       * credentialCategory "license" — тип, который разборщики понимают.
       *
       * Смысл в recognizedBy: утверждение становится проверяемым. Не «у нас
       * есть лицензия» прозой в подвале, а «документ с таким номером выдан
       * таким органом» — это можно сверить с реестром, и именно это модель
       * может процитировать.
       *
       * ⚠️ Орган берётся из facts.legal.issuer, и там висит ПРОВЕРЬ. Неверный
       * recognizedBy — ложное машиночитаемое утверждение о госоргане.
       *
       * Teenindaja kaart сюда НЕ добавлять: её выдают человеку, а не фирме,
       * и на узле организации она была бы неправдой. Причины, почему её нет
       * и на Person, — в комментарии к facts.legal.
       */
      hasCredential: {
        "@type": "EducationalOccupationalCredential",
        "@id": `${site}/#transport-licence`,
        name: t.licence,
        credentialCategory: "license",
        identifier: facts.legal.transportLicence,
        recognizedBy: { "@type": "GovernmentOrganization", name: facts.legal.issuer },
      },
      contactPoint: [
        {
          "@type": "ContactPoint",
          telephone: phone,
          contactType: t.booking,
          availableLanguage: ["ru", "en"],
        },
      ],
      // Работаем круглосуточно — для модели это отдельный проверяемый факт,
      // а не оборот «выезд в любое время» внутри абзаца.
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: [
            "https://schema.org/Monday",
            "https://schema.org/Tuesday",
            "https://schema.org/Wednesday",
            "https://schema.org/Thursday",
            "https://schema.org/Friday",
            "https://schema.org/Saturday",
            "https://schema.org/Sunday",
          ],
          opens: "00:00",
          closes: "23:59",
        },
      ],
      areaServed: [
        { "@type": "City", name: place.tallinn[lang] },
        { "@type": "City", name: place.tartu[lang] },
        { "@type": "City", name: place.narva[lang] },
        { "@type": "Place", name: place.koidula[lang] },
        { "@type": "Place", name: place.luhamaa[lang] },
        { "@type": "Country", name: lang === "ru" ? "Эстония" : "Estonia" },
      ],
      /**
       * Зона обслуживания вместо адреса. У сервиса нет офиса, и выдуманный
       * PostalAddress — прямое нарушение правил Google для бизнесов с зоной
       * обслуживания: за него карточку понижают. Поэтому `address` нет и не
       * будет, а вместо него описан радиус работы.
       *
       * Центр — Таллинн, откуда выезжают все маршруты. Радиус 300 км взят по
       * самому длинному из них: до Лухамаа 280. Это не обещание ехать ровно на
       * триста километров, а машиночитаемая граница «здесь мы работаем» —
       * именно её спрашивает ассистент, когда пользователь называет свой город.
       */
      serviceArea: {
        "@type": "GeoCircle",
        geoMidpoint: {
          "@type": "GeoCoordinates",
          latitude: 59.437,
          longitude: 24.7536,
        },
        geoRadius: "300000",
      },
      /**
       * Машина описана свойствами, а не отдельным узлом Vehicle — 31.08.2026.
       *
       * Было `vehicle: { "@type": "Vehicle", … }`, и Search Console ругалась на
       * обе главные: «Provide a value for one of the following data elements:
       * offers, review, or aggregateRating». Причина в иерархии schema.org —
       * Vehicle наследник Product, и валидатор требует у него полей товара.
       * Ни одно из трёх сюда не годится: `offers` означал бы, что машина
       * продаётся (цена поездки и так лежит в makesOffer ниже), а рейтинг без
       * настоящих отзывов выдумывать нельзя — за это снимают сниппеты со всего
       * сайта.
       *
       * Вдобавок свойства `vehicle` в schema.org нет вообще (страница отдаёт
       * 404), так что узел висел на выдуманном ключе и пользы не приносил.
       *
       * PropertyValue Product не наследует, валидатор товаров его не трогает, а
       * additionalProperty — законное свойство Place, от которого LocalBusiness
       * наследуется наравне с Organization. Факт про машину при этом остаётся
       * машиночитаемым, ради чего узел и заводили.
       */
      additionalProperty: [
        {
          "@type": "PropertyValue",
          name: lang === "ru" ? "Автомобиль" : "Vehicle",
          value: facts.car,
        },
        {
          "@type": "PropertyValue",
          name: lang === "ru" ? "Пассажирских мест" : "Passenger seats",
          value: facts.seats,
        },
        {
          "@type": "PropertyValue",
          name: lang === "ru" ? "Класс автомобиля" : "Vehicle class",
          value: lang === "ru" ? "седан, кондиционер" : "sedan, air conditioning",
        },
      ],
      employee: {
        "@type": "Person",
        name: facts.driver,
        jobTitle: lang === "ru" ? "Водитель" : "Driver",
        worksFor: { "@id": org },
      },
      makesOffer: offers,
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: t.catalog,
        itemListElement: offers,
      },
    },
    {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      url: `${site}/`,
      name: "EstoniaTransfer",
      inLanguage: lang,
      publisher: { "@id": org },
    },
    {
      "@type": "WebPage",
      "@id": `${home}#webpage`,
      url: home,
      isPartOf: { "@id": `${site}/#website` },
      about: { "@id": org },
      inLanguage: lang,
      // Та же дата, что уходит в lastmod карты сайта для главной, — правится
      // руками в siteUpdated. Модель, пришедшая по ссылке из ответа, видит
      // свежесть страницы, не заглядывая в карту. `datePublished` не ставим:
      // даты первой публикации в данных нет, а выдуманная хуже отсутствующей.
      dateModified: siteUpdated,
      // Блок коротких ответов — то, что голосовым помощникам стоит читать
      // вслух и что модели проще всего вытащить как факт.
      speakable: {
        "@type": "SpeakableSpecification",
        cssSelector: ["#answers"],
      },
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
