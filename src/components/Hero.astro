---
/**
 * Первый экран главной. На телефоне — полоса фото над заголовком, на
 * десктопе (от lg) фото нет — решение владельца 02.10.2026: одна колонка,
 * текст и кнопки по центру, под ними карточки доверия.
 *
 * Фото на телефоне — самый крупный элемент первого экрана (LCP): eager,
 * fetchpriority="high", без .reveal, плюс preload в <head> (HeroPreload.astro).
 * Варианты — heroImage.ts, один источник для <picture> и preload.
 * Для десктопа в <picture> стоит пустой GIF: скрытый <img> иначе всё равно
 * скачал бы фото.
 *
 * Стеклянные плашки поверх фото: цена Нарвы и оценка Google — из facts.
 */
import BrandIcon from "./BrandIcon.astro";
import TrustBar from "./TrustBar.astro";
import { heroSources, heroMedia, blankImage } from "./heroImage";
import { useTranslations, facts, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const narva = facts.routes.find((r) => r.id === "narva")!;

// Те же варианты, что предзагружает HeroPreload.astro в <head>: один источник
// в heroImage.ts, разойтись адресам нельзя.
const { mob, fallback } = await heroSources();

const copy = {
  ru: {
    alt: `${facts.car} EstoniaTransfer — машина для трансфера к границе`,
    route: `Таллинн → Нарва · ${narva.price} €`,
  },
  en: {
    alt: `${facts.car} EstoniaTransfer — the car for border transfers`,
    route: `Tallinn → Narva · €${narva.price}`,
  },
}[lang];
const chip =
  "glass absolute flex items-center gap-2 rounded-full px-3.5 py-2 text-[0.85rem] font-semibold tabular-nums text-ink sm:px-4 sm:py-2.5 sm:text-[0.92rem]";
---

<section class="relative overflow-hidden">
  {/* Цветные пятна: фон, на котором читается стекло карточек доверия.
      ⚠️ Прозрачность пятен — 35% и 20%, как было. На 30% Chrome рисует
      размытое пятно концентрическими бирюзовыми кольцами (проверено
      02.10.2026 и на живом сайте: та же поломка при /30). Меняете —
      смотрите скриншот, сборка этого не поймает. */}
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    {/* Позиции пятен — в rem, а не в %: проценты считаются от высоты
        секции, и когда при подмене шрифта заголовок чуть менял высоту,
        пятно ехало вместе с ней — Lighthouse засчитывал это в CLS. */}
    <div class="blob -left-12 -top-40 size-[26rem] bg-brand/35"></div>
    <div class="blob -bottom-48 left-[35%] size-[24rem] bg-brand/20"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-5 pb-16 pt-5 sm:pb-20 sm:pt-8 lg:pt-14">
    {/* На десктопе фото нет (решение владельца 02.10.2026): одна колонка,
        текст по центру. На телефоне — полоса фото над заголовком. */}
    <div class="grid gap-8 lg:gap-0">
      {/* Фото — только до lg. lg:hidden прячет блок, а пустой GIF в <source>
          для десктопа не даёт браузеру скачать сам файл: скрытый <img>
          иначе всё равно грузится. */}
      <div class="relative lg:hidden">
        <picture>
          <source media={heroMedia.desk.media} srcset={blankImage} />
          <source type="image/avif" srcset={mob.avif} sizes={heroMedia.mob.sizes} />
          <source type="image/webp" srcset={mob.webp} sizes={heroMedia.mob.sizes} />
          <img
            src={fallback}
            alt={copy.alt}
            width="1200"
            height="675"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="aspect-video w-full rounded-[var(--radius-card)] bg-surface object-cover shadow-[0_24px_60px_-28px_rgb(11_11_12/0.45)]"
          />
        </picture>

        <p class={`${chip} left-3 top-3 sm:left-4 sm:top-4`}>
          <span class="size-2 rounded-full bg-brand" aria-hidden="true"></span>
          {copy.route}
        </p>
        <a
          href={facts.google.profile}
          target="_blank"
          rel="noopener"
          class={`${chip} bottom-3 right-3 transition-transform hover:-translate-y-0.5 sm:bottom-4 sm:right-4`}
        >
          {/* Звезда — жёлтая Google, как в подвале: она aria-hidden, оценка
              сказана словами рядом, поэтому контраст звезды здесь не важен */}
          <span class="text-[#FBBC04]" aria-hidden="true">★</span>
          {facts.google.rating}.0 Google
        </a>
      </div>

      <div class="lg:mx-auto lg:max-w-4xl lg:pt-6 lg:text-center">
        <p class="reveal text-[0.82rem] font-semibold uppercase tracking-[0.16em] text-brand-ink">
          {t("hero.eyebrow")}
        </p>

        <h1
          class="reveal mt-4 text-balance text-[clamp(2.2rem,5.6vw,4.4rem)] font-semibold leading-[1.04] tracking-[-0.035em] sm:mt-5"
          style="--d:1"
        >
          {t("hero.title.1")}<br />
          <span class="text-brand-ink">{t("hero.title.2")}</span>
        </h1>

        <p class="reveal mt-5 max-w-xl text-[1.04rem] leading-relaxed text-ink-muted sm:mt-6 lg:mx-auto lg:max-w-2xl lg:text-[1.1rem]" style="--d:2">
          {t("hero.lead")}
        </p>

        <div class="reveal mt-8 flex flex-wrap items-center gap-3 lg:justify-center" style="--d:3">
          <a
            href="#order"
            class="rounded-2xl bg-brand px-6 py-3.5 font-semibold text-ink shadow-[0_10px_24px_-12px_rgb(255_106_0/0.7)] transition hover:-translate-y-0.5 hover:bg-brand-hover"
          >
            {t("hero.cta")}
          </a>
          {/* inline-flex + items-center: иконка и текст выравниваются по середине
              строки, а не по базовой линии, иначе глиф съезжает вниз на пиксель */}
          <a
            href={facts.whatsapp}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2.5 rounded-2xl border border-line-strong/60 bg-page px-6 py-3.5 font-semibold text-ink transition-colors hover:bg-surface"
          >
            <BrandIcon name="whatsapp" class="size-5 shrink-0 text-[#25D366]" />
            {t("hero.secondary")}
          </a>
        </div>
      </div>
    </div>

    {/* Факты доверия — под героем, на фоне с пятнами: стекло читается только
        поверх цвета. */}
    <TrustBar lang={lang} />
  </div>
</section>
