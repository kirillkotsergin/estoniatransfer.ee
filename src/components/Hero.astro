---
/**
 * Первый экран главной (обновлён 02.10.2026): текст слева, фото справа; на
 * телефоне — полоса фото над заголовком. Раньше здесь был только текст, и
 * правая половина экрана на десктопе пустовала.
 *
 * Фото — самый крупный элемент первого экрана (LCP), поэтому:
 *  - loading="eager" и fetchpriority="high", без .reveal: анимация появления
 *    держала бы его прозрачным и отодвинула LCP;
 *  - арт-дирекция через <source media>: десктопу — кадр 4:5, заранее
 *    обрезанный к передней части машины; телефону — полный кадр 16:9. Один
 *    <Picture> с object-cover обрезал бы 4:5 из альбомного файла уже в
 *    браузере: машина ушла бы за край, а файл 800w растягивался бы до
 *    ~1240 px по ширине — мыльно и тяжелее, чем нужно;
 *  - AVIF и WebP, ширины 480/800/1200 — каждое устройство берёт один файл.
 *
 * Стеклянные плашки поверх фото: цена Нарвы и оценка Google — обе из facts,
 * цифр руками здесь нет.
 */
import { getImage } from "astro:assets";
import BrandIcon from "./BrandIcon.astro";
import TrustBar from "./TrustBar.astro";
import hero from "../assets/car/car-1.jpg";
import { useTranslations, facts, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const narva = facts.routes.find((r) => r.id === "narva")!;

// 640 добавлен к 480/800/1200 (02.10.2026): телефон с DPR 1.75 просит ~612 px,
// десктоп — 540 px, и без него оба качали 800w — на четверть-половину тяжелее.
const widths = [480, 640, 800, 1200];
const formats = ["avif", "webp"] as const;

/** srcset из нарезанных при сборке вариантов. ratio — высота к ширине, если кадр режем. */
async function srcset(format: (typeof formats)[number], ratio?: number) {
  const imgs = await Promise.all(
    widths.map((w) =>
      getImage({
        src: hero,
        width: w,
        ...(ratio ? { height: Math.round(w * ratio), fit: "cover" as const, position: "right" } : {}),
        format,
        quality: format === "avif" ? 55 : 70,
      })
    )
  );
  return imgs.map((img, i) => `${img.src} ${widths[i]}w`).join(", ");
}

const desk = { avif: await srcset("avif", 5 / 4), webp: await srcset("webp", 5 / 4) };
const mob = { avif: await srcset("avif"), webp: await srcset("webp") };
const fallback = await getImage({ src: hero, width: 800, format: "jpg", quality: 72 });

const copy = {
  ru: {
    alt: `${facts.car} EstoniaTransfer — машина для трансфера к границе`,
    route: `Таллинн → Нарва · ${narva.price} €`,
  },
  en: {
    alt: `${facts.car} EstoniaTransfer — the car for border transfers`,
    route: `Tallinn → Narva · €${narva.price}`,
  },
}[lang];
const chip =
  "glass absolute flex items-center gap-2 rounded-full px-3.5 py-2 text-[0.85rem] font-semibold tabular-nums text-ink sm:px-4 sm:py-2.5 sm:text-[0.92rem]";
---

<section class="relative overflow-hidden">
  {/* Цветные пятна: фон, на котором читается стекло карточек доверия.
      ⚠️ Прозрачность пятен — 35% и 20%, как было. На 30% Chrome рисует
      размытое пятно концентрическими бирюзовыми кольцами (проверено
      02.10.2026 и на живом сайте: та же поломка при /30). Меняете —
      смотрите скриншот, сборка этого не поймает. */}
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    {/* Позиции пятен — в rem, а не в %: проценты считаются от высоты
        секции, и когда при подмене шрифта заголовок чуть менял высоту,
        пятно ехало вместе с ней — Lighthouse засчитывал это в CLS. */}
    <div class="blob -left-12 -top-40 size-[26rem] bg-brand/35"></div>
    <div class="blob -bottom-48 left-[35%] size-[24rem] bg-brand/20"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-5 pb-16 pt-5 sm:pb-20 sm:pt-8 lg:pt-14">
    {/* items-start, а не items-center: по центру колонка текста сдвигалась
        на половину разницы высот, когда шрифт подменялся, — это сдвиг
        макета (CLS). Визуальный баланс держит отступ lg:pt-10 у текста. */}
    <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-14">
      {/* Фото. На телефоне — первым, полосой над заголовком (order-first);
          на десктопе — справа. */}
      <div class="relative lg:order-last">
        <picture>
          <source media="(min-width: 1024px)" type="image/avif" srcset={desk.avif} sizes="(min-width: 1152px) 540px, 46vw" />
          <source media="(min-width: 1024px)" type="image/webp" srcset={desk.webp} sizes="(min-width: 1152px) 540px, 46vw" />
          <source type="image/avif" srcset={mob.avif} sizes="calc(100vw - 2.5rem)" />
          <source type="image/webp" srcset={mob.webp} sizes="calc(100vw - 2.5rem)" />
          <img
            src={fallback.src}
            alt={copy.alt}
            width="1200"
            height="675"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="aspect-video w-full rounded-[var(--radius-card)] bg-surface object-cover shadow-[0_24px_60px_-28px_rgb(11_11_12/0.45)] lg:aspect-[4/5]"
          />
        </picture>

        <p class={`${chip} left-3 top-3 sm:left-4 sm:top-4`}>
          <span class="size-2 rounded-full bg-brand" aria-hidden="true"></span>
          {copy.route}
        </p>
        <a
          href={facts.google.profile}
          target="_blank"
          rel="noopener"
          class={`${chip} bottom-3 right-3 transition-transform hover:-translate-y-0.5 sm:bottom-4 sm:right-4`}
        >
          {/* Звезда — жёлтая Google, как в подвале: она aria-hidden, оценка
              сказана словами рядом, поэтому контраст звезды здесь не важен */}
          <span class="text-[#FBBC04]" aria-hidden="true">★</span>
          {facts.google.rating}.0 Google
        </a>
      </div>

      <div class="lg:pt-10">
        <p class="reveal text-[0.82rem] font-semibold uppercase tracking-[0.16em] text-brand-ink">
          {t("hero.eyebrow")}
        </p>

        <h1
          class="reveal mt-4 text-balance text-[clamp(2.2rem,5.6vw,3.75rem)] font-semibold leading-[1.04] tracking-[-0.035em] sm:mt-5"
          style="--d:1"
        >
          {t("hero.title.1")}<br />
          <span class="text-brand-ink">{t("hero.title.2")}</span>
        </h1>

        <p class="reveal mt-5 max-w-xl text-[1.04rem] leading-relaxed text-ink-muted sm:mt-6" style="--d:2">
          {t("hero.lead")}
        </p>

        <div class="reveal mt-8 flex flex-wrap items-center gap-3" style="--d:3">
          <a
            href="#order"
            class="rounded-2xl bg-brand px-6 py-3.5 font-semibold text-ink shadow-[0_10px_24px_-12px_rgb(255_106_0/0.7)] transition hover:-translate-y-0.5 hover:bg-brand-hover"
          >
            {t("hero.cta")}
          </a>
          {/* inline-flex + items-center: иконка и текст выравниваются по середине
              строки, а не по базовой линии, иначе глиф съезжает вниз на пиксель */}
          <a
            href={facts.whatsapp}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2.5 rounded-2xl border border-line-strong/60 bg-page px-6 py-3.5 font-semibold text-ink transition-colors hover:bg-surface"
          >
            <BrandIcon name="whatsapp" class="size-5 shrink-0 text-[#25D366]" />
            {t("hero.secondary")}
          </a>
        </div>
      </div>
    </div>

    {/* Факты доверия — под героем, на фоне с пятнами: стекло читается только
        поверх цвета. */}
    <TrustBar lang={lang} />
  </div>
</section>
