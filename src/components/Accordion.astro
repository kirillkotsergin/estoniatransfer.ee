---
/**
 * Раскрывающиеся блоки на нативном <details>: работают без JS, с клавиатуры
 * и доступны для чтения краулером — текст внутри есть в HTML, а не появляется
 * по клику. Используется на посадочных страницах для блока про погранпереход,
 * для FAQ и для разбора способов доехать в гиде.
 *
 * Текст приходит с разметкой (ссылки, <strong>), поэтому вставляется через
 * set:html. Источник — свои же файлы в src/data, не пользовательский ввод.
 */
interface Props {
  items: {
    title: string;
    text: string;
    /** короткие пары «что — сколько»: расписание, цена, расстояние */
    specs?: [string, string][];
    /** ссылка на первоисточник: сайт перевозчика, система бронирования */
    link?: { label: string; href: string };
  }[];
  /** какой пункт открыт при загрузке; по умолчанию все закрыты */
  open?: number;
}
const { items, open } = Astro.props;

const prose =
  "mt-3 text-[0.95rem] leading-relaxed text-ink-muted [&_a]:font-semibold [&_a]:text-brand-ink [&_a:hover]:underline";
---

<div class="grid gap-3">
  {
    items.map((it, i) => (
      <details class="reveal glass group rounded-2xl px-5 py-4" style={`--d:${i + 1}`} open={i === open}>
        <summary class="flex items-start justify-between gap-4 text-[1.02rem] font-semibold tracking-tight">
          <span>{it.title}</span>
          <span
            class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-brand-soft text-brand-ink transition-transform group-open:rotate-45"
            aria-hidden="true"
          >
            <svg viewBox="0 0 20 20" fill="none" class="size-3.5">
              <path
                d="M10 4.5v11M4.5 10h11"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
              />
            </svg>
          </span>
        </summary>

        {it.specs && (
          <dl class="mt-4 grid gap-x-6 gap-y-2 border-t border-line pt-4 text-[0.9rem] sm:grid-cols-2">
            {it.specs.map(([label, value]) => (
              <div class="flex flex-wrap items-baseline gap-x-2">
                <dt class="text-ink-dim">{label}</dt>
                <dd class="font-semibold">{value}</dd>
              </div>
            ))}
          </dl>
        )}

        <div class={prose} set:html={it.text} />

        {it.link && (
          <a
            href={it.link.href}
            target="_blank"
            rel="noopener nofollow"
            class="mt-3 inline-flex items-center gap-1.5 text-[0.9rem] font-semibold text-brand-ink hover:underline"
          >
            {it.link.label}
            <span aria-hidden="true">↗</span>
          </a>
        )}
      </details>
    ))
  }
</div>
