---
import { facts, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  /** compact — узкий вид для подвала, full — кнопки в блоке заявки */
  variant?: "full" | "compact";
}
const { lang, variant = "full" } = Astro.props;

// Логотипы берутся с внешнего CDN, локальных файлов нет — так и заказано.
// Раз запрос уходит на сторону, домен добавлен в img-src в public/.htaccess,
// иначе Content-Security-Policy просто не даст картинкам загрузиться.
const logo = {
  wa: "https://cdn.simpleicons.org/whatsapp/25D366",
  tg: "https://cdn.simpleicons.org/telegram/26A5E4",
};

const items = [
  {
    href: facts.whatsapp,
    label: "WhatsApp",
    src: logo.wa,
    hint: lang === "ru" ? "Ответим сразу" : "We reply instantly",
  },
  {
    href: facts.telegram,
    label: "Telegram",
    src: logo.tg,
    hint: lang === "ru" ? "Можно без звонка" : "No call needed",
  },
];
---

{
  variant === "full" ? (
    <div class="grid gap-2.5 sm:grid-cols-2">
      {items.map((m) => (
        <a
          href={m.href}
          target="_blank"
          rel="noopener"
          class="glass flex items-center gap-3 rounded-xl px-4 py-3 transition-transform hover:-translate-y-0.5"
        >
          <img
            src={m.src}
            alt=""
            width="24"
            height="24"
            loading="lazy"
            decoding="async"
            class="size-6 shrink-0"
          />
          <span class="min-w-0">
            <span class="block font-semibold leading-tight">{m.label}</span>
            <span class="block text-[0.8rem] text-ink-dim">{m.hint}</span>
          </span>
        </a>
      ))}
    </div>
  ) : (
    <ul class="grid gap-2 text-[0.95rem]">
      {items.map((m) => (
        <li>
          <a
            href={m.href}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 hover:text-brand-ink"
          >
            <img
              src={m.src}
              alt=""
              width="18"
              height="18"
              loading="lazy"
              decoding="async"
              class="size-4.5"
            />
            {m.label}
          </a>
        </li>
      ))}
    </ul>
  )
}
