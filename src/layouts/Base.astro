---
import "../styles/global.css";
import { getImage } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import OrderFab from "../components/OrderFab.astro";
import ogSource from "../assets/car/car-1.jpg";
import {
  useTranslations,
  languages,
  defaultLang,
  localePath,
  verification,
  type Lang,
} from "../i18n/ui";

interface Props {
  lang: Lang;
  path?: string;
  title?: string;
  description?: string;
  /** описание для соцсетей, если оно должно отличаться от meta description */
  ogDescription?: string;
  /** website у страниц услуг, article у гида — от этого зависит вид карточки */
  ogType?: "website" | "article";
  /**
   * Страница не должна попадать в индекс. Нужно 404-й: она отдаётся по любому
   * несуществующему адресу, и без noindex поисковик заводит в индексе столько
   * «страниц не найдено», сколько битых ссылок на сайт нашлось.
   */
  noindex?: boolean;
  /**
   * Языки, на которых ЭТА страница существует. По умолчанию все: главная
   * переведена целиком. У посадочных страниц маршрутов список приходит из
   * данных — hreflang не должен ссылаться на перевод, которого нет.
   */
  langs?: Lang[];
}

const allLangs = Object.keys(languages) as Lang[];
const {
  lang,
  path = "/",
  title,
  description,
  ogDescription,
  ogType = "website",
  noindex = false,
  langs = allLangs,
} = Astro.props;
const t = useTranslations(lang);
const site = Astro.site?.origin ?? "https://estoniatransfer.ee";

/**
 * Картинка для карточки ссылки. Заказ идёт через WhatsApp и Telegram, и
 * развёрнутая карточка с фото машины — это первое, что там видит пассажир;
 * без og:image мессенджер показывает голый текст.
 *
 * Собирается из того же фото, что и галерея: 1200×630 — размер, который ждут
 * Facebook, WhatsApp, Telegram и Twitter. Отдельный файл не нужен, Astro
 * режет его на сборке. Адрес обязан быть абсолютным — краулеры соцсетей
 * относительные пути не разворачивают.
 */
const ogImage = await getImage({
  src: ogSource,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "center",
  format: "jpeg",
});
const ogImageUrl = new URL(ogImage.src, site).href;
const pageTitle = title ?? t("meta.title");
const pageDesc = description ?? t("meta.description");
const canonical = new URL(localePath(lang, path), site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta
      name="robots"
      content={
        noindex
          ? "noindex, follow"
          : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
      }
    />

    {/* У noindex-страницы ни canonical, ни hreflang не ставим: 404-я отдаётся
        по любому несуществующему адресу, и canonical на главную превращал бы
        каждую опечатку в заявку «проиндексируй вместо неё главную». */}
    {!noindex && <link rel="canonical" href={canonical} />}

    {/* Каждый язык — отдельный URL, плюс x-default. Без этого поисковик
        считает версии дублями, а не переводами. Список — только реально
        существующие переводы этой страницы. */}
    {
      !noindex &&
        langs.map((l) => (
          <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), site).href} />
        ))
    }
    {
      !noindex && langs.includes(defaultLang) && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(localePath(defaultLang, path), site).href}
        />
      )
    }

    {/* Подтверждение владения в панелях вебмастеров. Пустое значение — тега нет.
        Google подтверждён TXT-записью в DNS, здесь его быть и не должно. */}
    {verification.bing && <meta name="msvalidate.01" content={verification.bing} />}
    {verification.yandex && <meta name="yandex-verification" content={verification.yandex} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="EstoniaTransfer" />
    <meta property="og:locale" content={lang === "ru" ? "ru_RU" : "en_US"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={ogDescription ?? pageDesc} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(ogImage.attributes.height ?? 630)} />
    <meta
      property="og:image:alt"
      content={
        lang === "ru"
          ? "Toyota Corolla EstoniaTransfer — трансфер из Таллинна к границе"
          : "Toyota Corolla EstoniaTransfer — transfer from Tallinn to the border"
      }
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Иконки. Порядок и размеры подогнаны под требования Google к иконке
        в выдаче: она должна быть квадратной и **кратной 48 px** (48, 96, 192)
        либо валидным SVG. Поэтому первыми идут SVG и PNG кратных размеров.

        Раньше здесь первым стоял <link rel="icon" href="/favicon.ico"
        sizes="32x32"> — то есть Google прямым текстом сообщали размер 32,
        который его правилу не отвечает. Сам .ico остался для старых браузеров,
        но уже без атрибута sizes: внутри три кадра (16, 32, 48), и врать про
        один из них незачем.

        apple-touch-icon нужен отдельным файлом: iOS не читает ни SVG, ни
        манифест. Файлы генерируются из favicon.svg скриптом
        tools/make-icons.mjs — руками не правим, иначе разойдутся. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-192x192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="theme-color" content="#ffffff" />

    {/* Метка до отрисовки: анимации появления включаются только с JS,
        без него контент виден целиком. */}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="bg-page text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
      >{lang === "ru" ? "Перейти к содержанию" : "Skip to content"}</a
    >

    <Header lang={lang} path={path} langs={langs} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <OrderFab lang={lang} />

    <script is:inline>
      // Появление при скролле. Ванильно и дешёво: ~600 байт, без библиотек.
      // Если IntersectionObserver недоступен — показываем всё сразу.
      (function () {
        "use strict";
        var items = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window)) {
          for (var i = 0; i < items.length; i++) items[i].classList.add("is-in");
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add("is-in");
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.06 }
        );
        items.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
