---
import "../styles/global.css";
import { getImage } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import OrderFab from "../components/OrderFab.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import ogSource from "../assets/car/car-1.jpg";
import {
  useTranslations,
  languages,
  defaultLang,
  localePath,
  verification,
  googleAds,
  facts,
  type Lang,
} from "../i18n/ui";

interface Props {
  lang: Lang;
  path?: string;
  title?: string;
  description?: string;
  /** описание для соцсетей, если оно должно отличаться от meta description */
  ogDescription?: string;
  /** website у страниц услуг, article у гида — от этого зависит вид карточки */
  ogType?: "website" | "article";
  /**
   * Страница не должна попадать в индекс. Нужно 404-й: она отдаётся по любому
   * несуществующему адресу, и без noindex поисковик заводит в индексе столько
   * «страниц не найдено», сколько битых ссылок на сайт нашлось.
   */
  noindex?: boolean;
  /**
   * Языки, на которых ЭТА страница существует. По умолчанию все: главная
   * переведена целиком. У посадочных страниц маршрутов список приходит из
   * данных — hreflang не должен ссылаться на перевод, которого нет.
   */
  langs?: Lang[];
}

const allLangs = Object.keys(languages) as Lang[];
const {
  lang,
  path = "/",
  title,
  description,
  ogDescription,
  ogType = "website",
  noindex = false,
  langs = allLangs,
} = Astro.props;
const t = useTranslations(lang);
const site = Astro.site?.origin ?? "https://estoniatransfer.ee";

/**
 * Картинка для карточки ссылки. Заказ идёт через WhatsApp и Telegram, и
 * развёрнутая карточка с фото машины — это первое, что там видит пассажир;
 * без og:image мессенджер показывает голый текст.
 *
 * Собирается из того же фото, что и галерея: 1200×630 — размер, который ждут
 * Facebook, WhatsApp, Telegram и Twitter. Отдельный файл не нужен, Astro
 * режет его на сборке. Адрес обязан быть абсолютным — краулеры соцсетей
 * относительные пути не разворачивают.
 */
const ogImage = await getImage({
  src: ogSource,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "center",
  format: "jpeg",
});
const ogImageUrl = new URL(ogImage.src, site).href;
const pageTitle = title ?? t("meta.title");
const pageDesc = description ?? t("meta.description");
const canonical = new URL(localePath(lang, path), site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta
      name="robots"
      content={
        noindex
          ? "noindex, follow"
          : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
      }
    />

    {/* У noindex-страницы ни canonical, ни hreflang не ставим: 404-я отдаётся
        по любому несуществующему адресу, и canonical на главную превращал бы
        каждую опечатку в заявку «проиндексируй вместо неё главную». */}
    {!noindex && <link rel="canonical" href={canonical} />}

    {/* Каждый язык — отдельный URL, плюс x-default. Без этого поисковик
        считает версии дублями, а не переводами. Список — только реально
        существующие переводы этой страницы. */}
    {
      !noindex &&
        langs.map((l) => (
          <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), site).href} />
        ))
    }
    {
      !noindex && langs.includes(defaultLang) && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(localePath(defaultLang, path), site).href}
        />
      )
    }

    {/* Подтверждение владения в панелях вебмастеров. Пустое значение — тега нет.
        Google подтверждён TXT-записью в DNS, здесь его быть и не должно. */}
    {verification.bing && <meta name="msvalidate.01" content={verification.bing} />}
    {verification.yandex && <meta name="yandex-verification" content={verification.yandex} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="EstoniaTransfer" />
    <meta property="og:locale" content={lang === "ru" ? "ru_RU" : "en_US"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={ogDescription ?? pageDesc} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(ogImage.attributes.height ?? 630)} />
    <meta
      property="og:image:alt"
      content={
        lang === "ru"
          ? `${facts.car} EstoniaTransfer — трансфер из Таллинна к границе`
          : `${facts.car} EstoniaTransfer — transfer from Tallinn to the border`
      }
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Иконки. Порядок и размеры подогнаны под требования Google к иконке
        в выдаче: она должна быть квадратной и **кратной 48 px** (48, 96, 192)
        либо валидным SVG. Поэтому первыми идут SVG и PNG кратных размеров.

        Раньше здесь первым стоял <link rel="icon" href="/favicon.ico"
        sizes="32x32"> — то есть Google прямым текстом сообщали размер 32,
        который его правилу не отвечает. Сам .ico остался для старых браузеров,
        но уже без атрибута sizes: внутри три кадра (16, 32, 48), и врать про
        один из них незачем.

        apple-touch-icon нужен отдельным файлом: iOS не читает ни SVG, ни
        манифест. Файлы генерируются из favicon.svg скриптом
        tools/make-icons.mjs — руками не правим, иначе разойдутся. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-192x192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon-precomposed" href="/apple-touch-icon-precomposed.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="theme-color" content="#ffffff" />

    {/* Метка до отрисовки: анимации появления включаются только с JS,
        без него контент виден целиком. */}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    {/* Ahrefs Web Analytics.

        is:inline обязателен: без него Astro попробует обработать тег как свой
        модуль. async — чтобы сторонний скрипт не задерживал отрисовку.

        Ключ data-key публичный, он и так виден в HTML каждому посетителю.

        Cookie счётчик не ставит — в analytics.js нет ни одного обращения к
        document.cookie, проверено. Поэтому баннер согласия сайту по-прежнему
        не нужен, как и для нашего счётчика посещений. Добавите Google
        Analytics — баннер понадобится.

        ⚠️ Домен обязан быть прописан в CSP (script-src и connect-src в
        public/.htaccess). При default-src 'self' браузер иначе блокирует
        загрузку молча: ни ошибки на странице, ни записи в логах — только
        пустой отчёт в Ahrefs. */}
    <script
      src="https://analytics.ahrefs.com/analytics.js"
      data-key="S/fOM82aG8zzRinAm3OnqA"
      async
      is:inline></script>

    {/* Google Ads: базовый тег плюс отслеживание конверсий по клику.

        Пустой googleAds.id — и ничего этого в HTML нет: подробности и два
        условия включения (CSP, баннер согласия) — в шапке googleAds в
        src/i18n/ui.ts.

        is:inline здесь не украшение. Без него Astro собирает <script> как
        ES-модуль и выносит в /_astro/hoisted.*.js, а у модуля своя область
        видимости: ни gtag, ни gtagSendEvent не попадают в window, и вызов из
        onclick падает с «gtagSendEvent is not defined». Падает молча — кнопка
        просто перестаёт работать. */}
    {/* Consent Mode v2 — дефолты.

        ⚠️ ЭТОТ СКРИПТ ОБЯЗАН СТОЯТЬ ДО gtag.js. Не «желательно»: Consent
        Mode читает состояние в момент инициализации тега, и дефолты,
        выставленные после загрузки gtag.js, не применяются вообще. Ошибка
        молчаливая — тег работает, cookie ставятся, а вы об этом узнаете
        только от регулятора. Переставите блоки местами — сломаете всё.

        Почему denied всем, а не только ЕЭЗ: определить регион на статике
        можно лишь внешним запросом, а это ещё одна зависимость и ещё один
        круг до рендера. Показывать баннер всем проще и строго безопаснее.

        wait_for_update даёт 500 мс на то, чтобы восстановленное согласие
        доехало до тега раньше, чем он решит отправить первый пинг.

        Отказ НЕ выключает тег: в denied он шлёт безкуковые пинги, из
        которых Google моделирует конверсии. Это и есть смысл Consent Mode —
        не «тег или ничего», а «с cookie или без».  */}
    {
      googleAds.id && (
        <script is:inline>
          {`
            window.dataLayer = window.dataLayer || [];
            function gtag(){ dataLayer.push(arguments); }

            gtag('consent', 'default', {
              ad_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
              analytics_storage: 'denied',
              wait_for_update: 500
            });

            /* Решение храним в localStorage, а не в cookie: до согласия в
               браузер не пишется вообще ничего. Cookie согласия была бы
               «строго необходимой» и формально разрешённой, но так спорить
               не о чем. */
            window.etConsent = {
              KEY: 'et-consent-v1',
              read: function () {
                try { return localStorage.getItem(this.KEY); } catch (e) { return null; }
              },
              set: function (value) {
                try { localStorage.setItem(this.KEY, value); } catch (e) {}
                var g = value === 'granted' ? 'granted' : 'denied';
                gtag('consent', 'update', {
                  ad_storage: g,
                  ad_user_data: g,
                  ad_personalization: g,
                  analytics_storage: g
                });
              }
            };

            /* Согласие из прошлого визита применяем немедленно, до gtag.js,
               иначе первый пинг уйдёт как denied и конверсия потеряется. */
            if (window.etConsent.read() === 'granted') {
              gtag('consent', 'update', {
                ad_storage: 'granted',
                ad_user_data: 'granted',
                ad_personalization: 'granted',
                analytics_storage: 'granted'
              });
            }
          `}
        </script>
      )
    }

    {
      googleAds.id && (
        <Fragment>
          <script
            src={`https://www.googletagmanager.com/gtag/js?id=${googleAds.id}`}
            async
            is:inline></script>
          <script
            is:inline
            define:vars={{
              adsId: googleAds.id,
              conversion: googleAds.conversion,
              phoneHref: facts.phoneHref,
              waBase: facts.whatsapp,
              tgBase: facts.telegram,
            }}
          >
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", adsId);

            /**
             * Отправка события с задержкой перехода. Это хелпер из панели
             * Google Ads, с двумя добавлениями, без которых он опасен:
             *
             * 1. Проверка, что gtag вообще загрузился. Блокировщик рекламы,
             *    оффлайн, сбой сети — и вызов gtag() бросает исключение,
             *    callback не срабатывает, перехода не происходит. То есть
             *    кнопка «Позвонить» перестаёт звонить. Потерянный звонок
             *    дороже потерянной конверсии, поэтому здесь сначала переход.
             * 2. Свой setTimeout. event_timeout спасает, только если gtag.js
             *    загрузился; если он загрузился, но запрос не ушёл,
             *    event_callback не вызовут никогда.
             */
            function send(name, url) {
              var navigated = false;
              var go = function () {
                if (navigated) return;
                navigated = true;
                if (typeof url === "string") window.location = url;
              };
              if (typeof gtag !== "function") {
                go();
                return false;
              }
              gtag("event", name, { event_callback: go, event_timeout: 2000 });
              window.setTimeout(go, 1200);
              return false;
            }

            /** Контракт из панели Google Ads: onclick="return gtagSendEvent(this.href)" */
            function gtagSendEvent(url) {
              return send(conversion, url);
            }

            /**
             * Цель конверсии определяется по самой ссылке, а не атрибутом на
             * каждой кнопке. Телефон и мессенджеры стоят в семнадцати местах —
             * в шапке, в герое, в модалке заказа, в форме, в подвале, на
             * каждой посадочной странице и на 404-й, — и адреса везде берутся
             * из facts. Значит и правило можно построить на facts: добавите
             * кнопку в новом блоке, она попадёт в отслеживание сама. Семнадцать
             * руками расставленных атрибутов однажды забыли бы на восемнадцатой.
             *
             * data-gtag-event остаётся как явное дополнение: атрибут задаёт
             * своё имя события для чего угодно ещё.
             */
            function conversionName(a) {
              var own = a.getAttribute("data-gtag-event");
              if (own) return own;
              var h = a.getAttribute("href") || "";
              if (h === phoneHref) return conversion;
              if (h.indexOf(waBase) === 0 || h.indexOf(tgBase) === 0) return conversion;
              return null;
            }

            document.addEventListener("click", function (e) {
              var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
              if (!a) return;

              // Средняя кнопка, Ctrl/Cmd-клик, уже отменённое событие — это
              // осознанный выбор посетителя открыть ссылку иначе, не мешаем.
              if (e.defaultPrevented || e.button !== 0) return;
              if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

              var name = conversionName(a);
              if (!name) return;

              var href = a.getAttribute("href") || "";

              /*
               * Новая вкладка, tel: и mailto: страницу не выгружают, поэтому
               * задерживать переход не нужно и вредно: window.location увёл бы
               * текущую вкладку вместо открытия новой, а у tel: управление
               * забирает набиратель номера — событие успевает уйти само.
               * beacon доживает до отправки даже при выгрузке.
               *
               * На сегодня все наши цели попадают именно сюда: мессенджеры
               * стоят с target="_blank", телефон — это tel:. Ветка с задержкой
               * ниже нужна, если конверсию когда-нибудь навесят на обычную
               * ссылку в той же вкладке.
               */
              if (a.target === "_blank" || /^(tel:|mailto:)/i.test(href)) {
                gtag("event", name, { transport_type: "beacon" });
                return;
              }

              e.preventDefault();
              send(name, a.href);
            });
          </script>
        </Fragment>
      )
    }
  </head>

  <body class="bg-page text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
      >{lang === "ru" ? "Перейти к содержанию" : "Skip to content"}</a
    >

    <Header lang={lang} path={path} langs={langs} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <OrderFab lang={lang} />
    {/* Тем же условием, что и сам тег: нет googleAds.id — нет cookie, и
        спрашивать не о чем. Впишете AW-… — баннер и Consent Mode включатся
        вместе с тегом, править больше нечего. */}
    {googleAds.id && <ConsentBanner lang={lang} />}

    <script is:inline>
      // Появление при скролле. Ванильно и дешёво: ~600 байт, без библиотек.
      // Если IntersectionObserver недоступен — показываем всё сразу.
      (function () {
        "use strict";
        var items = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window)) {
          for (var i = 0; i < items.length; i++) items[i].classList.add("is-in");
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add("is-in");
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.06 }
        );
        items.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
