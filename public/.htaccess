# ============================================================
# EstoniaTransfer — статика на zone.ee.
# После удаления WordPress его правила исчезли, поэтому базовые вещи —
# сжатие, кеш, заголовки безопасности и редирект www — задаём здесь.
# Всё в <IfModule>: если модуля нет, блок игнорируется, а не роняет сайт.
# ============================================================

AddDefaultCharset utf-8
ErrorDocument 404 /404.html

# Apache не знает расширение .webmanifest и отдаёт его как text/plain, а часть
# браузеров при неверном типе манифест просто игнорирует — иконки на домашнем
# экране Android тогда не появятся.
AddType application/manifest+json .webmanifest
AddType image/x-icon .ico

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → без www: канонический адрес без префикса
  RewriteCond %{HTTP_HOST} ^www\.estoniatransfer\.ee$ [NC]
  RewriteRule ^(.*)$ https://estoniatransfer.ee/$1 [R=301,L]

  # /index.html → / (дубль главной)
  RewriteCond %{THE_REQUEST} \s/+(.*)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml \
    application/manifest+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  # HTML не кешируем: деплой перезаписывает файлы, посетитель должен видеть свежее
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  # Иконки живут под своими постоянными именами, без хеша, поэтому год им нельзя:
  # заменишь логотип — у вернувшихся посетителей останется старый. Месяц.
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 month"
  # Ответ hits.php — это application/json. Без обнуления число посещений
  # застыло бы в кеше браузера на месяц.
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # PHP кешировать нельзя ни в каком виде: hits.php при кеше ответа перестал бы
  # считать посещения, а число в подвале застыло бы у посетителя в браузере.
  # Expires снимаем отдельно — ExpiresDefault ниже иначе выдаёт .php месяц.
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
    Header unset Expires
  </FilesMatch>

  # Astro кладёт статику в _astro/ с хешем в имени — можно кешировать навсегда
  <FilesMatch "^.*\.[0-9a-zA-Z]{8}\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Единственный внешний источник — cdn.simpleicons.org: оттуда берутся
  # официальные логотипы WhatsApp и Telegram. Всё остальное со своего домена.
  # 'unsafe-inline' нужен из-за встроенного <script> в head (метка js).
  # analytics.ahrefs.com прописан дважды: в script-src — чтобы загрузился
  # analytics.js, в connect-src — чтобы счётчик мог отправить туда события.
  # Без второго скрипт загрузится, но данные не уйдут, и это никак не
  # проявится: ни ошибки на странице, ни записи в логах сервера, только
  # пустой отчёт в панели Ahrefs.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://analytics.ahrefs.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.simpleicons.org; font-src 'self'; connect-src 'self' https://analytics.ahrefs.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
</IfModule>
