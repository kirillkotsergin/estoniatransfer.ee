# ============================================================
# EstoniaTransfer — статика на zone.ee.
# После удаления WordPress его правила исчезли, поэтому базовые вещи —
# сжатие, кеш, заголовки безопасности и редирект www — задаём здесь.
# Всё в <IfModule>: если модуля нет, блок игнорируется, а не роняет сайт.
# ============================================================

AddDefaultCharset utf-8
ErrorDocument 404 /404.html

# Apache не знает расширение .webmanifest и отдаёт его как text/plain, а часть
# браузеров при неверном типе манифест просто игнорирует — иконки на домашнем
# экране Android тогда не появятся.
AddType application/manifest+json .webmanifest
AddType image/x-icon .ico

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → без www: канонический адрес без префикса
  RewriteCond %{HTTP_HOST} ^www\.estoniatransfer\.ee$ [NC]
  RewriteRule ^(.*)$ https://estoniatransfer.ee/$1 [R=301,L]

  # /index.html → / (дубль главной)
  RewriteCond %{THE_REQUEST} \s/+(.*)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Старые адреса карты сайта от WordPress → на нашу карту.
  # По логам боты до сих пор просят /sitemap_index.xml (это путь Yoast SEO) и
  # /sitemap.txt и получают 404. Адреса остались в чужих индексах с прежнего
  # сайта; 301 возвращает этот сигнал себе вместо того, чтобы терять его.
  #
  # 14.09.2026 добавлен .xml.gz: сжатую карту боты тоже спрашивают, и она
  # оставалась единственным вариантом из четырёх, который отдавал 404.
  #
  # 23.09.2026 добавлен .rss — последний из этого списка, который ещё отдавал
  # 404: по логам за 18–23.09 его просили четыре раза. Это тоже путь Yoast,
  # он отдавал ленту последних записей WordPress. Ленты у нас нет, но 301 на
  # карту сайта возвращает сигнал себе, а 404 его просто теряет.
  RewriteRule ^sitemap(_index\.xml|\.txt|-index\.xml|\.xml\.gz|\.rss)$ /sitemap.xml [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml \
    application/manifest+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  # HTML не кешируем: деплой перезаписывает файлы, посетитель должен видеть свежее
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  # Иконки живут под своими постоянными именами, без хеша, поэтому год им нельзя:
  # заменишь логотип — у вернувшихся посетителей останется старый. Месяц.
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 month"
  # Ответ hits.php — это application/json. Без обнуления число посещений
  # застыло бы в кеше браузера на месяц.
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
    # Expires снимаем по той же причине, что и у .php ниже: ExpiresDefault
    # выдаёт месяц, и рядом с no-cache получались два противоречащих
    # заголовка. Cache-Control по спецификации главнее, так что ломалось не
    # всё, — но карта сайта, llms.txt и фид приезжали с «годен до» на месяц
    # вперёд, и любой наивный прокси имел право отдавать их месяц.
    # Именно эти файлы и должны перечитываться: в них дата правки, ради
    # которой всё и затевалось.
    Header unset Expires
  </FilesMatch>

  # Atom-фид. Apache по расширению .xml отдаёт text/xml, а для Atom
  # правильный тип application/atom+xml — по нему фид узнают читалки и
  # агрегаторы. ForceType, а не AddType: менять тип всем .xml нельзя,
  # карта сайта должна остаться XML общего вида.
  <Files "feed.xml">
    ForceType application/atom+xml
  </Files>

  # PHP кешировать нельзя ни в каком виде: hits.php при кеше ответа перестал бы
  # считать посещения, а число в подвале застыло бы у посетителя в браузере.
  # Expires снимаем отдельно — ExpiresDefault ниже иначе выдаёт .php месяц.
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
    Header unset Expires
  </FilesMatch>

  # Astro кладёт статику в _astro/ с хешем в имени — можно кешировать навсегда
  <FilesMatch "^.*\.[0-9a-zA-Z]{8}\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Внешние источники: cdn.simpleicons.org — официальные логотипы WhatsApp и
  # Telegram, analytics.ahrefs.com — счётчик, googletagmanager и домены Google —
  # конверсии Google Ads. Всё остальное со своего домена.
  # 'unsafe-inline' нужен из-за встроенного <script> в head (метка js).
  #
  # analytics.ahrefs.com прописан дважды: в script-src — чтобы загрузился
  # analytics.js, в connect-src — чтобы счётчик мог отправить туда события.
  # Без второго скрипт загрузится, но данные не уйдут, и это никак не
  # проявится: ни ошибки на странице, ни записи в логах сервера, только
  # пустой отчёт в панели Ahrefs.
  #
  # Google Ads (src/i18n/ui.ts → googleAds) занимает четыре директивы, и
  # каждая нужна по своей причине:
  #   script-src  — загрузка самого gtag.js;
  #   connect-src — отправка события (fetch/beacon на google-analytics.com и
  #                 googleads.g.doubleclick.net);
  #   img-src     — конверсионные «пиксели»: gtag дозванивается до
  #                 google.com/ads и doubleclick картинкой;
  #   frame-src   — iframe линкера конверсий на td.doubleclick.net. Раньше
  #                 frame-src в политике не было вовсе, и он падал на
  #                 default-src 'self' — то есть iframe блокировался бы.
  # Звёздочка в *.google-analytics.com не для красоты: боевой домен зависит от
  # региона посетителя (region1, region4 и так далее).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://analytics.ahrefs.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.simpleicons.org https://www.google.com https://googleads.g.doubleclick.net; font-src 'self'; connect-src 'self' https://analytics.ahrefs.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://googleads.g.doubleclick.net; frame-src https://td.doubleclick.net https://www.googletagmanager.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
</IfModule>
