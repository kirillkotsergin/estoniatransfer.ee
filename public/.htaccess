# ============================================================
# EstoniaTransfer — статика на zone.ee.
# После удаления WordPress его правила исчезли, поэтому базовые вещи —
# сжатие, кеш, заголовки безопасности и редирект www — задаём здесь.
# Всё в <IfModule>: если модуля нет, блок игнорируется, а не роняет сайт.
# ============================================================

AddDefaultCharset utf-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → без www: канонический адрес без префикса
  RewriteCond %{HTTP_HOST} ^www\.estoniatransfer\.ee$ [NC]
  RewriteRule ^(.*)$ https://estoniatransfer.ee/$1 [R=301,L]

  # /index.html → / (дубль главной)
  RewriteCond %{THE_REQUEST} \s/+(.*)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  # HTML не кешируем: деплой перезаписывает файлы, посетитель должен видеть свежее
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Astro кладёт статику в _astro/ с хешем в имени — можно кешировать навсегда
  <FilesMatch "^.*\.[0-9a-zA-Z]{8}\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Сайт не грузит ничего извне: ни шрифтов, ни аналитики, ни CDN.
  # 'unsafe-inline' нужен из-за встроенного <script> в head (метка js).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
</IfModule>
